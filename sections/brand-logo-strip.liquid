{%- if section.blocks.size > 0 -%}
{%- assign section_key = 'BrandLogoStrip-' | append: section.id -%}
{%- assign brand_menu_source = linklists[section.settings.brand_menu_source] -%}
<div id="{{ section_key }}" class="brand-logo-strip brand-logo-strip--{{ section.id }}{% if section.settings.show_divider %} brand-logo-strip--divider{% else %} brand-logo-strip--no-divider{% endif %}">
  <style>
    #shopify-section-{{ section.id }} {
      border-top: 0 !important;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip {
      background: {{ section.settings.background }};
      border-top: 0 !important;
    }

    #shopify-section-{{ section.id }} > .brand-logo-strip--divider {
      border-top: 1px solid rgba(0, 0, 0, 0.12) !important;
    }

    #shopify-section-{{ section.id }} > .brand-logo-strip--no-divider {
      border-top: 0 !important;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__inner {
      padding: {{ section.settings.padding_y }}px 0 0;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__tabs {
      display: grid;
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
      gap: {{ section.settings.desktop_gap }}px;
      align-items: center;
      justify-items: center;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__tab {
      appearance: none;
      border: 0;
      background: transparent;
      padding: 0 0 14px;
      width: 100%;
      min-height: {{ section.settings.desktop_row_height }}px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      color: inherit;
      text-decoration: none;
      opacity: 0.78;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__tab::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 0;
      height: 4px;
      transform: translateX(-50%);
      background: {{ section.settings.active_underline_color }};
      transition: width 0.22s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__tab.is-active::after,
    #shopify-section-{{ section.id }} .brand-logo-strip__tab:hover::after,
    #shopify-section-{{ section.id }} .brand-logo-strip__tab:focus-visible::after {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__tab.is-active,
    #shopify-section-{{ section.id }} .brand-logo-strip__tab:hover,
    #shopify-section-{{ section.id }} .brand-logo-strip__tab:focus-visible {
      opacity: 1;
      transform: translateY(-1px);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__image {
      display: block;
      width: auto;
      height: auto;
      max-width: {{ section.settings.desktop_logo_width }}px;
      max-height: {{ section.settings.desktop_logo_height }}px;
      object-fit: contain;
      object-position: center center;
      transition: transform 0.25s ease, opacity 0.25s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__tab:hover .brand-logo-strip__image,
    #shopify-section-{{ section.id }} .brand-logo-strip__tab:focus-visible .brand-logo-strip__image,
    #shopify-section-{{ section.id }} .brand-logo-strip__tab.is-active .brand-logo-strip__image {
      transform: translateY(-1px);
      opacity: 0.94;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__panel {
      display: none;
      background: {{ section.settings.panel_background }};
      border-top: 1px solid rgba(0, 0, 0, 0.16);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__panel.is-active {
      display: block;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__panel-inner {
      width: min(100%, 1440px);
      margin: 0 auto;
      padding: {{ section.settings.panel_padding_y }}px 24px {{ section.settings.panel_padding_y }}px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mega-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 28px 36px;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column h3 {
      margin: 0;
      color: {{ section.settings.panel_title_color }};
      font-size: 16px;
      font-weight: 600;
      line-height: 1.1;
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column h3 a {
      color: inherit;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column h3 a:hover {
      color: {{ section.settings.active_underline_color }};
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column ul {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 14px;
      line-height: 1.55;
      color: {{ section.settings.panel_text }};
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column li + li {
      margin-top: 10px;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column a {
      color: inherit;
      text-decoration: none;
      transition: color 0.18s ease, opacity 0.18s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__column a:hover {
      color: {{ section.settings.active_underline_color }};
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-accordion {
      display: none;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item {
      border-top: 1px solid rgba(0, 0, 0, 0.12);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item:last-child {
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      width: 100%;
      padding: 10px 14px;
      box-sizing: border-box;
      color: inherit;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-brand {
      display: inline-flex;
      align-items: center;
      min-width: 0;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-brand-link {
      flex: 1 1 auto;
      min-width: 0;
      color: inherit;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-caret-btn {
      flex: 0 0 auto;
      appearance: none;
      border: 0;
      background: transparent;
      padding: 6px;
      margin: -6px -2px -6px 0;
      color: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-image {
      display: block;
      width: auto;
      height: auto;
      max-width: {{ section.settings.mobile_logo_width }}px;
      max-height: {{ section.settings.mobile_logo_height }}px;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-title {
      font-size: 14px;
      font-weight: 600;
      line-height: 1.2;
      color: {{ section.settings.panel_title_color }};
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-caret {
      flex: 0 0 auto;
      color: rgba(0, 0, 0, 0.55);
      width: 8px;
      height: 8px;
      line-height: 1;
      border-top: 2px solid currentColor;
      border-right: 2px solid currentColor;
      transform: rotate(45deg);
      transform-origin: center;
      transition: transform 0.2s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-caret::before {
      content: "";
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-caret svg {
      display: none;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item.is-open .brand-logo-strip__mobile-caret {
      color: {{ section.settings.active_underline_color }};
      transform: rotate(135deg);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-panel {
      padding: 0 14px 12px;
      background: {{ section.settings.panel_background }};
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-columns {
      display: grid;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column {
      border-top: 1px solid rgba(0, 0, 0, 0.10);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-head {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 6px 0 5px;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-link {
      flex: 1 1 auto;
      min-width: 0;
      display: inline-flex;
      align-items: center;
      color: {{ section.settings.panel_title_color }} !important;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.25;
      padding: 2px 0;
      transition: color 0.18s ease, opacity 0.18s ease;
      -webkit-tap-highlight-color: transparent;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-link:hover,
    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-link:focus-visible {
      color: {{ section.settings.active_underline_color }} !important;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-toggle {
      flex: 0 0 auto;
      appearance: none;
      border: 0;
      background: transparent;
      padding: 5px;
      margin: -5px 0 -5px auto;
      color: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-caret {
      flex: 0 0 auto;
      color: rgba(0, 0, 0, 0.55);
      width: 7px;
      height: 7px;
      line-height: 1;
      border-top: 2px solid currentColor;
      border-right: 2px solid currentColor;
      transform: rotate(45deg);
      transform-origin: center;
      transition: transform 0.2s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-caret::before {
      content: "";
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-caret svg {
      display: none;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column.is-open .brand-logo-strip__mobile-column-toggle .brand-logo-strip__mobile-column-caret {
      color: {{ section.settings.active_underline_color }};
      transform: rotate(135deg);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-panel {
      padding: 0 0 12px;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-panel ul {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 14px;
      line-height: 1.55;
      color: {{ section.settings.panel_text }};
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-panel a {
      color: {{ section.settings.panel_text }} !important;
      text-decoration: none;
      transition: color 0.18s ease, opacity 0.18s ease;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-panel a:hover,
    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-panel a:focus-visible {
      color: {{ section.settings.active_underline_color }} !important;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-column-panel li + li {
      margin-top: 10px;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-panel[hidden] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item.is-open > .brand-logo-strip__mobile-trigger {
      background: rgba(0, 0, 0, 0.025);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item.is-current > .brand-logo-strip__mobile-trigger {
      background: rgba(224, 43, 32, 0.05);
    }

    #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item.is-current .brand-logo-strip__mobile-title {
      color: {{ section.settings.active_underline_color }};
    }

    @media (max-width: 989px) {
      #shopify-section-{{ section.id }} .brand-logo-strip__inner {
        padding-top: {{ section.settings.mobile_padding_y }}px;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__tabs {
        display: none;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__panels {
        display: none;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__mobile-accordion {
        display: block;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__mobile-item {
        background: {{ section.settings.panel_background }};
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__tab {
        min-height: {{ section.settings.mobile_row_height }}px;
        padding-bottom: 10px;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__image {
        max-width: {{ section.settings.mobile_logo_width }}px;
        max-height: {{ section.settings.mobile_logo_height }}px;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__panel-inner {
        width: 100%;
        padding: {{ section.settings.mobile_panel_padding_y }}px 16px {{ section.settings.mobile_panel_padding_y }}px;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__mobile-columns {
        grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
        gap: {{ section.settings.mobile_gap }}px;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__mega-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__column h3 {
        font-size: 15px;
        margin-bottom: 10px;
        padding-bottom: 8px;
        color: {{ section.settings.panel_title_color }};
      }

      #shopify-section-{{ section.id }} .brand-logo-strip__column ul {
        font-size: 13px;
      }
    }
  </style>

  <div class="{{ section.settings.setwidth }} brand-logo-strip__inner">
    <div class="brand-logo-strip__tabs" role="tablist" aria-label="{{ section.settings.aria_label | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.brand_link != blank -%}
          <a
            href="{{ block.settings.brand_link }}"
            class="brand-logo-strip__tab"
            data-brand-tab="{{ block.id }}"
            aria-controls="BrandLogoStripPanel-{{ section.id }}-{{ block.id }}"
            aria-selected="false"
            {{ block.shopify_attributes }}>
        {%- else -%}
          <button
            type="button"
            class="brand-logo-strip__tab"
            data-brand-tab="{{ block.id }}"
            aria-controls="BrandLogoStripPanel-{{ section.id }}-{{ block.id }}"
            aria-selected="false"
            {{ block.shopify_attributes }}>
        {%- endif -%}
          {%- if block.settings.image != blank -%}
            <img
              class="brand-logo-strip__image"
              src="{{ block.settings.image | img_url: '800x' }}"
              srcset="{{ block.settings.image | img_url: '800x' }} 1x, {{ block.settings.image | img_url: '1200x' }} 2x"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}">
          {%- else -%}
            <span>{{ block.settings.title | escape }}</span>
          {%- endif -%}
        {%- if block.settings.brand_link != blank -%}
          </a>
        {%- else -%}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="brand-logo-strip__panels">
      {%- for block in section.blocks -%}
        {%- assign brand_handle = block.settings.title | strip | split: '[' | first | strip | handleize -%}
        {%- assign brand_menu_item = blank -%}
        {%- assign brand_columns_source = blank -%}

        {%- if brand_menu_source != blank and brand_menu_source.links.size > 0 -%}
          {%- for menu_item in brand_menu_source.links -%}
            {%- assign menu_item_handle = menu_item.title | strip | split: '[' | first | strip | handleize -%}
            {%- if menu_item_handle == brand_handle -%}
              {%- assign brand_menu_item = menu_item -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if brand_menu_item != blank and brand_menu_item.links.size > 0 -%}
          {%- assign brand_columns_source = brand_menu_item -%}
        {%- elsif block.settings.submenu_menu != blank -%}
          {%- assign brand_columns_source = linklists[block.settings.submenu_menu] -%}
        {%- endif -%}

        <section
          id="BrandLogoStripPanel-{{ section.id }}-{{ block.id }}"
          class="brand-logo-strip__panel"
          data-brand-panel="{{ block.id }}"
          role="tabpanel"
          aria-hidden="true">
          <div class="brand-logo-strip__panel-inner">
            {%- if brand_columns_source != blank and brand_columns_source.links.size > 0 -%}
              <div class="brand-logo-strip__mega-grid">
                {%- for column_link in brand_columns_source.links -%}
                  <div class="brand-logo-strip__column">
                    <h3>
                      <a href="{{ column_link.url }}">{{ column_link.title }}</a>
                    </h3>
                    {%- if column_link.links.size > 0 -%}
                      <ul>
                        {%- for item_link in column_link.links -%}
                          <li>
                            <a href="{{ item_link.url }}">{{ item_link.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <ul>
                        <li>
                          <a href="{{ column_link.url }}">{{ column_link.title }}</a>
                        </li>
                      </ul>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- elsif block.settings.content_html != blank -%}
              <div class="brand-logo-strip__column">
                {{ block.settings.content_html }}
              </div>
            {%- endif -%}
          </div>
        </section>
      {%- endfor -%}
    </div>

    <div class="brand-logo-strip__mobile-accordion">
      {%- for block in section.blocks -%}
        {%- assign brand_handle = block.settings.title | strip | split: '[' | first | strip | handleize -%}
        {%- assign brand_menu_item = blank -%}
        {%- assign brand_columns_source = blank -%}

        {%- if brand_menu_source != blank and brand_menu_source.links.size > 0 -%}
          {%- for menu_item in brand_menu_source.links -%}
            {%- assign menu_item_handle = menu_item.title | strip | split: '[' | first | strip | handleize -%}
            {%- if menu_item_handle == brand_handle -%}
              {%- assign brand_menu_item = menu_item -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if brand_menu_item != blank and brand_menu_item.links.size > 0 -%}
          {%- assign brand_columns_source = brand_menu_item -%}
        {%- elsif block.settings.submenu_menu != blank -%}
          {%- assign brand_columns_source = linklists[block.settings.submenu_menu] -%}
        {%- endif -%}

        <div class="brand-logo-strip__mobile-item">
          <div class="brand-logo-strip__mobile-trigger">
            {%- if block.settings.brand_link != blank -%}
              <a href="{{ block.settings.brand_link }}" class="brand-logo-strip__mobile-brand brand-logo-strip__mobile-brand-link" aria-label="{{ block.settings.title | escape }}">
            {%- else -%}
              <span class="brand-logo-strip__mobile-brand">
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img
                  class="brand-logo-strip__mobile-image"
                  src="{{ block.settings.image | img_url: '400x' }}"
                  srcset="{{ block.settings.image | img_url: '400x' }} 1x, {{ block.settings.image | img_url: '800x' }} 2x"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}">
              {%- else -%}
                <span class="brand-logo-strip__mobile-title">{{ block.settings.title | escape }}</span>
              {%- endif -%}
            {%- if block.settings.brand_link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}

            <button
              type="button"
              class="brand-logo-strip__mobile-caret-btn"
              aria-expanded="false"
              aria-controls="BrandLogoStripMobilePanel-{{ section.id }}-{{ block.id }}"
              data-mobile-brand="{{ block.id }}">
              <span class="brand-logo-strip__mobile-caret" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            </button>
          </div>

          <div
            id="BrandLogoStripMobilePanel-{{ section.id }}-{{ block.id }}"
            class="brand-logo-strip__mobile-panel"
            data-mobile-panel="{{ block.id }}"
            hidden>
            {%- if brand_columns_source != blank and brand_columns_source.links.size > 0 -%}
              <div class="brand-logo-strip__mobile-columns">
                {%- for column_link in brand_columns_source.links -%}
                  <div class="brand-logo-strip__mobile-column" data-mobile-column>
                    <div class="brand-logo-strip__mobile-column-head">
                      <a href="{{ column_link.url }}" class="brand-logo-strip__mobile-column-link">{{ column_link.title }}</a>
                      <button type="button" class="brand-logo-strip__mobile-column-toggle" aria-expanded="false" aria-controls="BrandLogoStripMobileColumn-{{ section.id }}-{{ block.id }}-{{ forloop.index }}" data-mobile-column-toggle>
                        <span class="brand-logo-strip__mobile-column-caret" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        </span>
                      </button>
                    </div>
                    <div id="BrandLogoStripMobileColumn-{{ section.id }}-{{ block.id }}-{{ forloop.index }}" class="brand-logo-strip__mobile-column-panel" hidden>
                    {%- if column_link.links.size > 0 -%}
                      <div class="brand-logo-strip__mobile-links">
                        <ul>
                          {%- for item_link in column_link.links -%}
                            <li>
                              <a href="{{ item_link.url }}">{{ item_link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- else -%}
                      <ul>
                        <li>
                          <a href="{{ column_link.url }}">{{ column_link.title }}</a>
                        </li>
                      </ul>
                    {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- elsif block.settings.content_html != blank -%}
              <div class="brand-logo-strip__column">
                {{ block.settings.content_html }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

    <script>
    (function () {
      var root = document.getElementById('{{ section_key }}');
      if (!root) return;

      var isTouchLike = (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) || (navigator.maxTouchPoints || 0) > 0;
      var currentBrandId = null;

      function normalizePath(path) {
        if (!path) return '';
        return path.replace(/\/+$/, '') || '/';
      }

      function getCurrentBrandId() {
        var currentPath = normalizePath(window.location.pathname);
        var matchedId = null;

        root.querySelectorAll('[data-brand-tab][href]').forEach(function (tab) {
          var href = tab.getAttribute('href');

          if (!href || href === '#') {
            return;
          }

          try {
            var url = new URL(href, window.location.origin);
            if (normalizePath(url.pathname) === currentPath) {
              matchedId = tab.getAttribute('data-brand-tab');
            }
          } catch (error) {
            // Ignore malformed URLs and continue.
          }
        });

        return matchedId;
      }

      function activateBrand(id) {
        var brandTabs = root.querySelectorAll('[data-brand-tab]');
        var brandPanels = root.querySelectorAll('[data-brand-panel]');

        brandTabs.forEach(function (tab) {
          var active = tab.getAttribute('data-brand-tab') === id;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        brandPanels.forEach(function (panel) {
          var active = panel.getAttribute('data-brand-panel') === id;
          panel.classList.toggle('is-active', active);
          panel.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
      }

      function syncCurrentBrandState() {
        var brandTabs = root.querySelectorAll('[data-brand-tab]');
        var brandPanels = root.querySelectorAll('[data-brand-panel]');

        brandTabs.forEach(function (tab) {
          var active = currentBrandId && tab.getAttribute('data-brand-tab') === currentBrandId;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        brandPanels.forEach(function (panel) {
          panel.classList.remove('is-active');
          panel.setAttribute('aria-hidden', 'true');
        });
      }

      function closeMobileItems(exceptId) {
        root.querySelectorAll('[data-mobile-brand]').forEach(function (btn) {
          var brandId = btn.getAttribute('data-mobile-brand');
          var panel = root.querySelector('[data-mobile-panel="' + brandId + '"]');
          var isExcept = exceptId && brandId === exceptId;

          if (!panel || isExcept) {
            return;
          }

          btn.setAttribute('aria-expanded', 'false');
          btn.parentNode.classList.remove('is-open');
          panel.hidden = true;
        });
      }

      function syncCurrentMobileState() {
        root.querySelectorAll('[data-mobile-brand]').forEach(function (btn) {
          var brandId = btn.getAttribute('data-mobile-brand');
          var item = btn.closest('.brand-logo-strip__mobile-item');
          var isCurrent = currentBrandId && brandId === currentBrandId;

          if (item) {
            item.classList.toggle('is-current', isCurrent);
          }
        });
      }

      root.querySelectorAll('[data-brand-tab]').forEach(function (tab) {
        tab.addEventListener('mouseenter', function () {
          activateBrand(tab.getAttribute('data-brand-tab'));
        });

        tab.addEventListener('focus', function () {
          activateBrand(tab.getAttribute('data-brand-tab'));
        });
      });

      root.addEventListener('mouseleave', function () {
        syncCurrentBrandState();
      });

      currentBrandId = getCurrentBrandId();
      syncCurrentBrandState();
      syncCurrentMobileState();

      if (isTouchLike) {
        root.querySelectorAll('[data-brand-tab]').forEach(function (tab) {
          tab.addEventListener('click', function (event) {
            event.preventDefault();
            var tabId = tab.getAttribute('data-brand-tab');
            var isActive = tab.classList.contains('is-active');

            if (isActive) {
              var href = tab.getAttribute('href');

              if (href && href !== '#') {
                window.location.href = href;
                return;
              }

              syncCurrentBrandState();
              return;
            }

            activateBrand(tabId);
          });
        });
      }

      root.querySelectorAll('[data-mobile-brand]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var brandId = btn.getAttribute('data-mobile-brand');
          var panel = root.querySelector('[data-mobile-panel="' + brandId + '"]');
          var isOpen = btn.getAttribute('aria-expanded') === 'true';

          closeMobileItems(brandId);

          if (!panel) {
            return;
          }

          if (isOpen) {
            btn.setAttribute('aria-expanded', 'false');
            btn.parentNode.classList.remove('is-open');
            panel.hidden = true;
            return;
          }

          btn.setAttribute('aria-expanded', 'true');
          btn.parentNode.classList.add('is-open');
          panel.hidden = false;
        });
      });

      root.querySelectorAll('[data-mobile-column-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();

          var column = btn.closest('.brand-logo-strip__mobile-column');
          var panel = column ? column.querySelector('.brand-logo-strip__mobile-column-panel') : null;
          var isOpen = btn.getAttribute('aria-expanded') === 'true';

          if (!panel) {
            return;
          }

          if (column && column.parentElement) {
            column.parentElement.querySelectorAll('.brand-logo-strip__mobile-column').forEach(function (otherColumn) {
              if (otherColumn === column) {
                return;
              }

              var otherToggle = otherColumn.querySelector('[data-mobile-column-toggle]');
              var otherPanel = otherColumn.querySelector('.brand-logo-strip__mobile-column-panel');

              if (otherToggle) {
                otherToggle.setAttribute('aria-expanded', 'false');
              }

              if (otherPanel) {
                otherPanel.hidden = true;
              }
            });
          }

          btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          panel.hidden = isOpen;
          column.classList.toggle('is-open', !isOpen);
        });
      });
    })();
  </script>
</div>
{%- endif -%}

