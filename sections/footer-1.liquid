  <script>
    (function() {
      var root = document.querySelector('[data-footer-accordion="{{ section.id }}"]');
      if (!root) return;

      var mobileQuery = window.matchMedia('(max-width: 749px)');
      var items = root.querySelectorAll('[data-footer-accordion-item]');

      function syncAccordionState() {
        items.forEach(function(item) {
          var toggle = item.querySelector('[data-footer-accordion-toggle]');
          var panel = item.querySelector('[data-footer-accordion-panel]');
          var isOpen = item.classList.contains('is-open');

          if (mobileQuery.matches) {
            if (toggle) toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            if (panel) panel.style.display = isOpen ? 'block' : 'none';
          } else {
            if (toggle) toggle.setAttribute('aria-expanded', 'true');
            if (panel) panel.style.display = '';
          }
        });
      }

      root.addEventListener('click', function(event) {
        var toggle = event.target.closest('[data-footer-accordion-toggle]');
        if (!toggle || !mobileQuery.matches) return;

        var item = toggle.closest('[data-footer-accordion-item]');
        var panel = item ? item.querySelector('[data-footer-accordion-panel]') : null;
        if (!item) return;

        var nextState = !item.classList.contains('is-open');
        item.classList.toggle('is-open', nextState);
        toggle.setAttribute('aria-expanded', nextState ? 'true' : 'false');
        if (panel) panel.style.display = nextState ? 'block' : 'none';
      });

      if (mobileQuery.addEventListener) {
        mobileQuery.addEventListener('change', syncAccordionState);
      } else if (mobileQuery.addListener) {
        mobileQuery.addListener(syncAccordionState);
      }

      syncAccordionState();
    })();
  </script>
