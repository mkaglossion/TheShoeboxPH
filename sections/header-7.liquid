<header class="site-header site-header--7{% if section.settings.enable_sticky %} site-header--sticky{% endif %}" role="banner" data-section-id="{{ section.id }}" data-section-type="header">
  <style>
    #shopify-section-{{ section.id }} {
      --header7-bg: {{ section.settings.background }};
      --header7-text: {{ section.settings.textcolor }};
      --header7-link: {{ section.settings.linkcolor }};
      --header7-link-hover: {{ section.settings.linkhover }};
      --header7-topbar-bg: {{ section.settings.topbarbg }};
      --header7-topbar-text: {{ section.settings.textcolor_top }};
      --header7-topbar-hover: {{ section.settings.textcolor_tophover }};
      --header7-border: rgba(0, 0, 0, 0.12);
      --header7-input-border: rgba(0, 0, 0, 0.42);
    }

    #shopify-section-{{ section.id }} .site-header--7 {
      position: {% if section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
      top: 0;
      z-index: 999;
      background: var(--header7-bg);
      color: var(--header7-text);
      border-bottom: 1px solid var(--header7-border);
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar {
      background: var(--header7-topbar-bg);
      color: var(--header7-topbar-text);
      font-size: 13px;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-inner {
      min-height: 42px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 18px;
      padding: 8px 0;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-toggle {
      display: none;
      appearance: none;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-transform: inherit;
      letter-spacing: inherit;
      padding: 0;
      align-items: center;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-toggle .icon {
      width: 14px;
      height: 14px;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-links {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 28px;
      flex-wrap: wrap;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-links a {
      color: inherit;
      text-decoration: none;
      transition: opacity 0.18s ease, color 0.18s ease;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-account {
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar-links a:hover,
    #shopify-section-{{ section.id }} .site-header-7__topbar-links a:focus-visible {
      color: var(--header7-topbar-hover);
    }

    #shopify-section-{{ section.id }} .site-header-7__main {
      background: var(--header7-bg);
    }

    #shopify-section-{{ section.id }} .site-header-7__topbar .container,
    #shopify-section-{{ section.id }} .site-header-7__topbar .container-fluid,
    #shopify-section-{{ section.id }} .site-header-7__main .container,
    #shopify-section-{{ section.id }} .site-header-7__main .container-fluid,
    #shopify-section-{{ section.id }} .site-header-7__main .full {
      padding-left: 32px;
      padding-right: 32px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .site-header-7__main-inner {
      min-height: 100px;
      display: grid;
      grid-template-columns: minmax(240px, 340px) minmax(0, 1fr) auto;
      align-items: center;
      gap: 30px;
      padding: 14px 0 16px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-menu {
      display: none;
      align-items: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .site-header-7__logo {
      display: flex;
      align-items: center;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .site-header-7__logo .site-header__logo,
    #shopify-section-{{ section.id }} .site-header-7__logo .site-header__logo-link {
      display: flex;
      align-items: center;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .site-header-7__logo .site-header__logo img {
      width: auto !important;
      max-width: 280px !important;
      max-height: 70px !important;
      height: auto !important;
    }

    #shopify-section-{{ section.id }} .site-header-7__search {
      min-width: 0;
      justify-self: center;
      width: min(100%, 700px);
      position: relative;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-form {
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      height: 58px;
      padding: 0 58px 0 22px;
      border: 1px solid var(--header7-input-border);
      border-radius: 999px;
      background: #fff;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      z-index: 50;
      display: none;
      margin: 0;
      padding: 18px 20px;
      border-radius: 18px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: #fff;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
      max-height: 420px;
      overflow: auto;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results.active {
      display: block;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item {
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item:last-child {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item .d-inline-flex {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: inherit;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item .image {
      flex: 0 0 72px;
      width: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item .image img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 10px;
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item .meta {
      width: auto;
      padding: 0;
      flex: 1 1 auto;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .ajax-search-item .title {
      margin: 0 0 4px;
      font-size: 14px;
      font-weight: 500;
      color: #111;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-results .btn--full {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      margin-top: 14px;
      padding: 12px 16px;
      border-radius: 999px;
      background: var(--header7-topbar-bg);
      color: #fff;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-button {
      appearance: none;
      border: 0;
      background: transparent;
      color: rgba(0, 0, 0, 0.54);
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-button .svg-search {
      width: 24px;
      height: 24px;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-clear {
      position: absolute;
      top: 50%;
      right: 18px;
      transform: translateY(-50%);
      appearance: none;
      border: 0;
      background: transparent;
      color: rgba(0, 0, 0, 0.58);
      padding: 0;
      display: none;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-clear .icon {
      width: 18px;
      height: 18px;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-form.is-filled .site-header-7__search-clear {
      display: inline-flex;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #111;
      font-size: 19px;
      letter-spacing: 0.02em;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-input::-webkit-search-cancel-button,
    #shopify-section-{{ section.id }} .site-header-7__search-input::-webkit-search-decoration,
    #shopify-section-{{ section.id }} .site-header-7__search-input::-webkit-search-results-button,
    #shopify-section-{{ section.id }} .site-header-7__search-input::-webkit-search-results-decoration {
      -webkit-appearance: none;
      appearance: none;
      display: none;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-button .icon,
    #shopify-section-{{ section.id }} .site-header-7__search-button svg {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .site-header-7__search-input::placeholder {
      color: rgba(0, 0, 0, 0.48);
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .site-header-7__actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .site-header-7__actions .site-header__link {
      color: var(--header7-link);
      padding: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .site-header-7__actions .site-header__link:hover,
    #shopify-section-{{ section.id }} .site-header-7__actions .site-header__link:focus-visible {
      color: var(--header7-link-hover);
    }

    #shopify-section-{{ section.id }} .site-header-7__actions .site-header__wishlist {
      padding-right: 4px;
    }

    #shopify-section-{{ section.id }} .site-header-7__actions .svg-heart,
    #shopify-section-{{ section.id }} .site-header-7__actions .svg-cart {
      width: 25.5px;
      height: 25.5px;
    }

    #shopify-section-{{ section.id }} .site-header-7__actions .site-header-7__search-link .svg-search,
    #shopify-section-{{ section.id }} .site-header-7__actions .site-header-7__search-link svg {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .site-header-7__actions .js-wishlist-link .js-wishlist-count,
    #shopify-section-{{ section.id }} .site-header-7__actions .site-header__cart-indicator {
      position: absolute;
      bottom: 7px;
      right: -12px;
      display: inline-block;
      min-width: 18px;
      width: 18px;
      height: 18px;
      padding: 0;
      border-radius: 50%;
      background: var(--g-main);
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      line-height: 18px;
      text-align: center;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1200;
    }

    body.site-header-7-search-open {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-toggle {
      appearance: none;
      border: 0;
      background: transparent;
      padding: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--header7-link);
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-toggle:hover,
    #shopify-section-{{ section.id }} .site-header-7__mobile-search-toggle:focus-visible {
      color: var(--header7-link-hover);
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-toggle .icon,
    #shopify-section-{{ section.id }} .site-header-7__mobile-search-toggle svg {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-overlay {
      position: fixed;
      inset: 0;
      z-index: 1200;
      display: none;
      background: rgba(17, 17, 17, 0.42);
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search.is-active {
      display: block;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-overlay.is-active {
      display: block;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-panel {
      position: absolute;
      inset: 0;
      min-height: 100%;
      background: #fff;
      display: flex;
      flex-direction: column;
      padding: 18px 16px 24px;
      box-sizing: border-box;
      overflow: auto;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 14px;
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-title {
      margin: 0;
      color: rgba(0, 0, 0, 0.6);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-close {
      appearance: none;
      border: 0;
      background: transparent;
      color: rgba(0, 0, 0, 0.72);
      padding: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-close .icon,
    #shopify-section-{{ section.id }} .site-header-7__mobile-search-close svg {
      width: 18px;
      height: 18px;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-form {
      width: 100%;
      max-width: 100%;
      padding: 0 56px 0 18px;
      height: 56px;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-body {
      position: relative;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .site-header-7__mobile-search-results {
      position: static;
      display: block;
      margin-top: 14px;
      max-height: none;
      overflow: visible;
      box-shadow: none;
      border-radius: 0;
      border: 0;
      padding: 0;
    }

    @media (max-width: 991px) {
      #shopify-section-{{ section.id }} .site-header-7__topbar {
        display: block;
        font-size: 11px;
        letter-spacing: 0.06em;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar-inner {
        min-height: 34px;
        justify-content: flex-start;
        align-items: center;
        flex-wrap: nowrap;
        gap: 12px;
        padding: 6px 0;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar-toggle {
        display: none;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar-links {
        display: flex;
        width: auto;
        justify-content: flex-start;
        gap: 14px;
        white-space: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar-links::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar-links a {
        flex: 0 0 auto;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar-account {
        display: none;
      }

      #shopify-section-{{ section.id }} .site-header-7__main-inner {
        min-height: 68px;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 12px;
        padding: 8px 0;
      }

      #shopify-section-{{ section.id }} .site-header-7__mobile-menu {
        display: flex;
      }

      #shopify-section-{{ section.id }} .site-header-7__search {
        display: none !important;
      }

      #shopify-section-{{ section.id }} .site-header-7__search-results {
        display: none !important;
      }

      #shopify-section-{{ section.id }} .site-header-7__mobile-search {
        display: none;
      }

      #shopify-section-{{ section.id }} .site-header-7__mobile-search .site-header-7__search {
        display: block !important;
        width: 100%;
      }

      #shopify-section-{{ section.id }} .site-header-7__mobile-search .site-header-7__search-results {
        display: block !important;
      }

      #shopify-section-{{ section.id }} .site-header-7__actions {
        gap: 4px;
      }

      #shopify-section-{{ section.id }} .site-header-7__actions .site-header__link {
        padding: 8px;
      }

      #shopify-section-{{ section.id }} .site-header-7__logo .site-header__logo img {
        max-width: 180px !important;
        max-height: 44px !important;
      }

      #shopify-section-{{ section.id }} .site-header-7__topbar .container,
      #shopify-section-{{ section.id }} .site-header-7__topbar .container-fluid,
      #shopify-section-{{ section.id }} .site-header-7__main .container,
      #shopify-section-{{ section.id }} .site-header-7__main .container-fluid,
      #shopify-section-{{ section.id }} .site-header-7__main .full {
        padding-left: 16px;
        padding-right: 16px;
      }
    }
  </style>

  {%- if section.settings.enabletopbar -%}
    {%- assign topbar_html = section.settings.text_topbar | strip -%}
    {%- capture topbar_account_link -%}
      <a href="/account" class="site-header-7__topbar-account">{%- if customer -%}Profile{%- else -%}Sign up / Login{%- endif -%}</a>
    {%- endcapture -%}
    <div class="site-header-7__topbar">
      <div class="{{ section.settings.setwidth }}">
        <div class="site-header-7__topbar-inner">
          {%- if topbar_html != blank -%}
            <div class="site-header-7__topbar-links" id="Header7TopbarLinks-{{ section.id }}">
              {%- if topbar_html contains '/account' -%}
                {{ topbar_html
                  | replace: '<a href="/account">Sign up / Login</a>', topbar_account_link
                  | replace: '<a href="/account">Profile</a>', topbar_account_link }}
              {%- else -%}
                {{ topbar_html }}
                {{ topbar_account_link }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="site-header-7__topbar-links" id="Header7TopbarLinks-{{ section.id }}">
              <a href="#">Find a store</a>
              {{ topbar_account_link }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="site-header-7__main">
    <div class="{{ section.settings.setwidth }}">
      <div class="site-header-7__main-inner">
        <div class="site-header-7__mobile-menu d-lg-none">
          {%- include 'button-toggle-menu-mobile' -%}
        </div>

        <div class="site-header-7__logo">
          {%- include 'site-logo' -%}
        </div>

        <div class="site-header-7__search">
          <form action="/search" method="get" class="site-header-7__search-form js-header7-search" role="search">
            <input type="hidden" name="type" value="product">
            <button type="submit" class="site-header-7__search-button" aria-label="{{ 'general.search.submit' | t }}">
              {%- include 'icon-search' -%}
            </button>
            <input
              type="text"
              name="q"
              class="site-header-7__search-input"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
              inputmode="search"
              enterkeyhint="search">
            <button type="button" class="site-header-7__search-clear js-search-clear" aria-label="Clear search">
              {%- include 'icon-close' -%}
            </button>
          </form>
          <div class="search-results site-header-7__search-results" role="listbox" aria-live="polite" aria-label="{{ 'general.search.title' | t }}"></div>
        </div>

        <div class="site-header-7__actions">
          <button type="button" class="site-header-7__mobile-search-toggle d-lg-none js-header7-mobile-search-open" aria-label="{{ 'general.search.title' | t }}">
            {%- include 'icon-search' -%}
          </button>
          {%- include 'block-wishlist', show_wishlist: true -%}
          <a href="/cart" class="site-header__link site-header__cart site-header-7__cart" title="{{ 'cart.general.title' | t }}">
            {%- include 'icon-cart' -%}
            <span class="icon__fallback-text">{{ 'layout.cart.title' | t }}</span>
            <span class="js-cart-count site-header__cart-indicator">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="site-header-7__mobile-search js-header7-mobile-search" aria-hidden="true">
    <div class="site-header-7__mobile-search-overlay js-header7-mobile-search-close"></div>
    <div class="site-header-7__mobile-search-panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.title' | t }}">
      <div class="site-header-7__mobile-search-head">
        <p class="site-header-7__mobile-search-title">{{ 'general.search.titleplace' | t }}</p>
        <button type="button" class="site-header-7__mobile-search-close js-header7-mobile-search-close" aria-label="Close search">
          {%- include 'icon-close' -%}
        </button>
      </div>
      <div class="site-header-7__mobile-search-body">
        <div class="site-header-7__search">
          <form action="/search" method="get" class="site-header-7__search-form site-header-7__search-form--mobile js-header7-search" role="search">
            <input type="hidden" name="type" value="product">
            <button type="submit" class="site-header-7__search-button" aria-label="{{ 'general.search.submit' | t }}">
              {%- include 'icon-search' -%}
            </button>
            <input
              type="text"
              name="q"
              class="site-header-7__search-input"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
              inputmode="search"
              enterkeyhint="search">
            <button type="button" class="site-header-7__search-clear js-search-clear" aria-label="Clear search">
              {%- include 'icon-close' -%}
            </button>
          </form>
          <div class="search-results site-header-7__search-results site-header-7__mobile-search-results" role="listbox" aria-live="polite" aria-label="{{ 'general.search.title' | t }}"></div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    var root = document.getElementById('shopify-section-{{ section.id }}');

    if (!root) {
      return;
    }

    function escapeHtml(value) {
      var div = document.createElement('div');

      div.textContent = value == null ? '' : String(value);

      return div.innerHTML;
    }

    function formatMoney(cents) {
      if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
        return window.theme.Currency.formatMoney(Number(cents) || 0, window.theme.moneyFormat);
      }

      return (Number(cents) || 0).toFixed(2);
    }

    function getSearchURL(term) {
      return '/search?type=product&q=' + encodeURIComponent('*' + term + '*');
    }

    function initSearch(form) {
      var searchWrap = form.closest('.site-header-7__search') || form.parentElement,
          input = form.querySelector('input[name="q"]'),
          results = searchWrap ? searchWrap.querySelector('.site-header-7__search-results') : null,
          clear = form.querySelector('.js-search-clear'),
          currentRequest = null,
          requestSerial = 0,
          debounceTimer = null,
          displayLimit = 6,
          minLength = 1;

      if (!input || !results) {
        return null;
      }

      function hideResults() {
        results.classList.remove('active');
        results.style.display = 'none';
        results.innerHTML = '';
      }

      function showResults() {
        results.classList.add('active');
        results.style.display = 'block';
      }

      function renderLoading(term) {
        var searchingText = (window.theme && window.theme.strings && window.theme.strings.ajaxSearchSearching) || 'Searching';

        results.innerHTML = '<p class="text-center site-header-7__search-loading">' + searchingText + ' "' + escapeHtml(term) + '"...</p>';
        showResults();
      }

      function renderResults(data, searchURL, serial) {
        var count = Number(data && data.results_count) || 0;

        if (serial !== requestSerial) {
          return;
        }

        results.innerHTML = '';

        if (!count) {
          results.innerHTML = '<p class="text-center">' + ((window.theme && window.theme.strings && window.theme.strings.ajaxSearchNoResult) || 'No results found') + '</p>';
          showResults();
          return;
        }

        (data.results || []).some(function(item, index) {
          var row, link, image, meta, title, price, img;

          if (index >= displayLimit) {
            return true;
          }

          row = document.createElement('div');
          row.className = 'ajax-search-item';

          link = document.createElement('a');
          link.className = 'd-inline-flex';
          link.href = item.url;

          image = document.createElement('span');
          image.className = 'image';

          meta = document.createElement('div');
          meta.className = 'meta';

          title = document.createElement('p');
          title.className = 'title';
          title.textContent = item.title || '';

          price = document.createElement('div');
          price.className = 'price';
          price.textContent = formatMoney(item.price || 0);

          if (item.thumbnail) {
            img = document.createElement('img');
            img.src = item.thumbnail;
            img.alt = item.title || '';
            img.loading = 'lazy';
            image.appendChild(img);
          }

          meta.appendChild(title);
          meta.appendChild(price);
          link.appendChild(image);
          link.appendChild(meta);
          row.appendChild(link);
          results.appendChild(row);
        });

        if (count > displayLimit) {
          var viewAll = document.createElement('a');
          viewAll.className = 'btn btn--full';
          viewAll.href = searchURL;
          viewAll.textContent = ((window.theme && window.theme.strings && window.theme.strings.ajaxSearchViewAll) || 'View all') + ' (' + count + ')';
          results.appendChild(viewAll);
        }

        if (window.theme && typeof window.theme.updateCurrencies === 'function') {
          window.theme.updateCurrencies();
        }

        showResults();
      }

      function fetchResults(term) {
        var searchURL = getSearchURL(term);
        var fetchURL = searchURL + '&view=json';

        if (currentRequest) {
          if (typeof currentRequest.abort === 'function') {
            currentRequest.abort();
          } else if (currentRequest.controller) {
            currentRequest.controller.abort();
          }
        }

        requestSerial += 1;

        if (window.AbortController && window.fetch) {
          currentRequest = { controller: new AbortController() };

          window.fetch(fetchURL, {
            credentials: 'same-origin',
            signal: currentRequest.controller.signal
          })
            .then(function(response) {
              if (!response.ok) {
                throw new Error('Search request failed');
              }

              return response.json();
            })
            .then(function(data) {
              renderResults(data, searchURL, requestSerial);
            })
            .catch(function(error) {
              if (error && error.name !== 'AbortError') {
                hideResults();
              }
            });

          return;
        }

        currentRequest = new XMLHttpRequest();
        currentRequest.open('GET', fetchURL, true);
        currentRequest.setRequestHeader('Accept', 'application/json');
        currentRequest.onreadystatechange = function() {
          if (currentRequest.readyState !== 4) {
            return;
          }

          if (currentRequest.status >= 200 && currentRequest.status < 300) {
            try {
              renderResults(JSON.parse(currentRequest.responseText), searchURL, requestSerial);
            } catch (error) {
              hideResults();
            }
            return;
          }

          if (currentRequest.status !== 0) {
            hideResults();
          }
        };
        currentRequest.send();
      }

      function handleInput() {
        var term = (input.value || '').trim();

        if (!term.length) {
          hideResults();
          form.classList.remove('is-filled');
          input.removeAttribute('data-old-term');
          return;
        }

        if (term.length < minLength) {
          hideResults();
          return;
        }

        if (term === input.getAttribute('data-old-term')) {
          return;
        }

        input.setAttribute('data-old-term', term);
        form.classList.add('is-filled');
        renderLoading(term);

        if (debounceTimer) {
          clearTimeout(debounceTimer);
        }

        debounceTimer = window.setTimeout(function() {
          fetchResults(term);
        }, 180);
      }

      input.setAttribute('autocomplete', 'off');
      input.setAttribute('spellcheck', 'false');
      input.setAttribute('inputmode', 'search');
      input.setAttribute('aria-autocomplete', 'list');

      input.addEventListener('input', handleInput);
      input.addEventListener('change', handleInput);
      input.addEventListener('paste', function() {
        window.setTimeout(handleInput, 0);
      });
      input.addEventListener('focus', function() {
        if ((input.value || '').trim().length) {
          handleInput();
        }
      });
      input.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
          input.value = '';
          input.removeAttribute('data-old-term');
          hideResults();
          form.classList.remove('is-filled');
        }
      });

      form.addEventListener('submit', function(event) {
        var term = (input.value || '').trim();

        event.preventDefault();

        if (!term.length) {
          hideResults();
          return;
        }

        input.setAttribute('data-old-term', term);
        renderLoading(term);
        fetchResults(term);
      });

      if (clear) {
        clear.addEventListener('click', function(event) {
          event.preventDefault();

          if (currentRequest) {
            if (typeof currentRequest.abort === 'function') {
              currentRequest.abort();
            } else if (currentRequest.controller) {
              currentRequest.controller.abort();
            }
          }

          input.value = '';
          input.removeAttribute('data-old-term');
          hideResults();
          form.classList.remove('is-filled');
          input.focus();
        });
      }

      document.addEventListener('click', function(event) {
        if (!searchWrap || !searchWrap.contains(event.target)) {
          hideResults();
        }
      });

      input.addEventListener('blur', function() {
        window.setTimeout(function() {
          if (!searchWrap || !searchWrap.contains(document.activeElement)) {
            hideResults();
          }
        }, 120);
      });

      if ((input.value || '').trim().length) {
        handleInput();
      }

      return {
        hideResults: hideResults,
        handleInput: handleInput,
        focus: function() {
          input.focus();
        },
        form: form
      };
    }

    var controllers = [],
        mobileSearch = root.querySelector('.js-header7-mobile-search'),
        mobileSearchOpen = root.querySelector('.js-header7-mobile-search-open');

    Array.prototype.forEach.call(root.querySelectorAll('.js-header7-search'), function(form) {
      var controller = initSearch(form);

      if (controller) {
        controllers.push(controller);
      }
    });

    function getMobileController() {
      var i;

      for (i = 0; i < controllers.length; i += 1) {
        if (controllers[i].form && controllers[i].form.closest('.site-header-7__mobile-search')) {
          return controllers[i];
        }
      }

      return null;
    }

    function openMobileSearch() {
      var controller = getMobileController();

      if (!mobileSearch) {
        return;
      }

      mobileSearch.classList.add('is-active');
      mobileSearch.setAttribute('aria-hidden', 'false');
      document.body.classList.add('site-header-7-search-open');

      if (controller) {
        controller.focus();
        controller.handleInput();
      }
    }

    function closeMobileSearch() {
      var controller = getMobileController();

      if (!mobileSearch) {
        return;
      }

      mobileSearch.classList.remove('is-active');
      mobileSearch.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('site-header-7-search-open');

      if (controller) {
        controller.hideResults();
      }
    }

    if (mobileSearchOpen) {
      mobileSearchOpen.addEventListener('click', function(event) {
        event.preventDefault();
        openMobileSearch();
      });
    }

    if (mobileSearch) {
      Array.prototype.forEach.call(mobileSearch.querySelectorAll('.js-header7-mobile-search-close'), function(trigger) {
        trigger.addEventListener('click', function(event) {
          event.preventDefault();
          closeMobileSearch();
        });
      });
    }

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && mobileSearch && mobileSearch.classList.contains('is-active')) {
        closeMobileSearch();
      }
    });
  })();
</script>

