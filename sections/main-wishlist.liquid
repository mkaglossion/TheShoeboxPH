<section class="wishlist-page">
  <style>
    #shopify-section-{{ section.id }} {
      --wishlist-bg: #ffffff;
      --wishlist-surface: #ffffff;
      --wishlist-border: rgba(17, 17, 17, 0.08);
      --wishlist-text: #141414;
      --wishlist-muted: rgba(20, 20, 20, 0.68);
      --wishlist-accent: var(--g-main, #d11f2a);
      background: var(--wishlist-bg);
      color: var(--wishlist-text);
      padding: 32px 0 72px;
    }

    #shopify-section-{{ section.id }} .wishlist-page__inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
    }

    #shopify-section-{{ section.id }} .wishlist-page__hero {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      padding: 22px 0 28px;
      margin-bottom: 28px;
      border-bottom: 1px solid var(--wishlist-border);
    }

    #shopify-section-{{ section.id }} .wishlist-page__eyebrow {
      margin: 0 0 10px;
      color: var(--wishlist-accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .wishlist-page__title {
      margin: 0;
      color: var(--wishlist-text);
      font-size: clamp(32px, 4vw, 54px);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    #shopify-section-{{ section.id }} .wishlist-page__summary {
      min-width: 180px;
      padding: 18px 20px;
      border: 1px solid var(--wishlist-border);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(8px);
      box-shadow: 0 16px 34px rgba(0, 0, 0, 0.06);
    }

    #shopify-section-{{ section.id }} .wishlist-page__summary-label {
      display: block;
      margin-bottom: 8px;
      color: var(--wishlist-muted);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .wishlist-page__summary-value {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      font-size: 34px;
      font-weight: 700;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .wishlist-page__summary-value small {
      font-size: 14px;
      font-weight: 500;
      color: var(--wishlist-muted);
    }

    #shopify-section-{{ section.id }} .wishlist-page__body {
      display: grid;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .wishlist-page__description {
      max-width: 760px;
      color: var(--wishlist-muted);
      font-size: 16px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .wishlist-page__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 2px;
    }

    #shopify-section-{{ section.id }} .wishlist-page__actions .btn {
      border-radius: 999px;
      min-height: 48px;
      padding: 12px 20px;
    }

    #shopify-section-{{ section.id }} .wishlist-page__grid {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 12px;
      align-items: start;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .wishlist-page__grid.row {
      margin-left: 0;
      margin-right: 0;
    }

    #shopify-section-{{ section.id }} .wishlist-page__item {
      display: flex;
      flex: 0 1 320px;
      width: 320px;
      max-width: 320px;
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .wishlist-card {
      width: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid var(--wishlist-border);
      border-radius: 24px;
      background: var(--wishlist-surface);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .wishlist-card__media {
      position: relative;
    }

    #shopify-section-{{ section.id }} .wishlist-card:hover,
    #shopify-section-{{ section.id }} .wishlist-card:focus-within {
      transform: translateY(-2px);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
    }

    #shopify-section-{{ section.id }} .wishlist-card__image {
      display: block;
      overflow: hidden;
      background: #f2f2f2;
      aspect-ratio: 1 / 1;
    }

    #shopify-section-{{ section.id }} .wishlist-card__image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 18px;
      display: block;
      transition: transform 0.28s ease;
    }

    #shopify-section-{{ section.id }} .wishlist-card__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      background:
        linear-gradient(135deg, rgba(209, 31, 42, 0.08), rgba(17, 17, 17, 0.04)),
        linear-gradient(135deg, #f4f4f4, #ebebeb);
    }

    #shopify-section-{{ section.id }} .wishlist-card:hover .wishlist-card__image img {
      transform: scale(1.03);
    }

    #shopify-section-{{ section.id }} .wishlist-card__remove {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: #111;
      box-shadow: none;
      cursor: pointer;
      font-size: 0;
      font-family: inherit;
      text-decoration: none;
      -webkit-appearance: none;
      appearance: none;
      overflow: hidden;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .wishlist-card__remove::before,
    #shopify-section-{{ section.id }} .wishlist-card__remove::after {
      content: none !important;
      display: none !important;
    }

    #shopify-section-{{ section.id }} .wishlist-card__remove svg {
      width: 18px;
      height: 18px;
      display: block;
      flex: 0 0 auto;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .wishlist-card__remove:hover,
    #shopify-section-{{ section.id }} .wishlist-card__remove:focus-visible {
      color: var(--wishlist-accent);
      outline: none;
    }

    #shopify-section-{{ section.id }} .wishlist-card__body {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 12px;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .wishlist-card__meta {
      display: grid;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .wishlist-card__title {
      color: var(--wishlist-text);
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }

    #shopify-section-{{ section.id }} .wishlist-card__title:hover,
    #shopify-section-{{ section.id }} .wishlist-card__title:focus-visible {
      color: var(--wishlist-accent);
    }

    #shopify-section-{{ section.id }} .wishlist-card__price {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px;
      color: var(--wishlist-text);
      font-size: 15px;
      font-weight: 600;
    }

    #shopify-section-{{ section.id }} .wishlist-card__price s {
      color: var(--wishlist-muted);
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .wishlist-card__price .wishlist-card__soldout {
      color: var(--wishlist-accent);
    }

    #shopify-section-{{ section.id }} .wishlist-card__actions {
      display: grid;
      margin-top: auto;
    }

    #shopify-section-{{ section.id }} .wishlist-card__view {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      border-radius: 999px;
      border: 1px solid var(--wishlist-border);
      color: var(--wishlist-text);
      text-decoration: none;
      font-weight: 600;
    }

    #shopify-section-{{ section.id }} .wishlist-card__view:hover,
    #shopify-section-{{ section.id }} .wishlist-card__view:focus-visible {
      border-color: var(--wishlist-accent);
      color: var(--wishlist-accent);
    }

    #shopify-section-{{ section.id }} .wishlist-empty {
      max-width: 680px;
      margin: 24px auto 0;
      padding: 42px 28px;
      text-align: center;
      border: 1px solid var(--wishlist-border);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.84);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    }

    #shopify-section-{{ section.id }} .wishlist-empty__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 68px;
      height: 68px;
      margin-bottom: 16px;
      border-radius: 50%;
      background: rgba(209, 31, 42, 0.08);
      color: var(--wishlist-accent);
    }

    #shopify-section-{{ section.id }} .wishlist-empty__title {
      margin: 0 0 10px;
      font-size: 28px;
      line-height: 1.1;
      color: var(--wishlist-text);
    }

    #shopify-section-{{ section.id }} .wishlist-empty__text {
      margin: 0 auto 22px;
      max-width: 520px;
      color: var(--wishlist-muted);
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .wishlist-empty__actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    @media (max-width: 991px) {
      #shopify-section-{{ section.id }} {
        padding: 22px 0 56px;
      }

      #shopify-section-{{ section.id }} .wishlist-page__inner {
        padding: 0 16px;
      }

      #shopify-section-{{ section.id }} .wishlist-page__hero {
        align-items: flex-start;
        flex-direction: column;
        padding-top: 14px;
      }

      #shopify-section-{{ section.id }} .wishlist-page__summary {
        width: 100%;
      }

      #shopify-section-{{ section.id }} .wishlist-page__grid {
        gap: 14px;
      }

      #shopify-section-{{ section.id }} .wishlist-page__item {
        flex-basis: calc(50% - 7px);
        width: calc(50% - 7px);
        max-width: calc(50% - 7px);
      }

      #shopify-section-{{ section.id }} .wishlist-card {
        max-width: 100%;
      }

      #shopify-section-{{ section.id }} .wishlist-empty {
        padding: 32px 20px;
      }
    }

    @media (max-width: 575px) {
      #shopify-section-{{ section.id }} .wishlist-page__grid {
        gap: 12px;
      }

      #shopify-section-{{ section.id }} .wishlist-page__item {
        flex-basis: 100%;
        width: 100%;
        max-width: 100%;
      }

      #shopify-section-{{ section.id }} .wishlist-card__body {
        padding: 16px;
      }

      #shopify-section-{{ section.id }} .wishlist-card__title {
        font-size: 15px;
      }

      #shopify-section-{{ section.id }} .wishlist-card__image img {
        padding: 14px;
      }

      #shopify-section-{{ section.id }} .wishlist-card__remove {
        top: 8px;
        right: 8px;
        width: 24px;
        height: 24px;
      }

      #shopify-section-{{ section.id }} .wishlist-empty__title {
        font-size: 24px;
      }
    }
  </style>

  <div class="wishlist-page__inner">
    <header class="wishlist-page__hero">
      <div class="wishlist-page__hero-copy">
        <p class="wishlist-page__eyebrow">Saved for later</p>
        <h1 class="wishlist-page__title">{{ page.title | default: 'Wishlist' }}</h1>
        {%- if page.content != blank -%}
          <div class="wishlist-page__description rte">
            {{ page.content }}
          </div>
        {%- else -%}
          <div class="wishlist-page__description">
            Keep the pieces you love in one place. Compare, review, and remove items without losing track.
          </div>
        {%- endif -%}
      </div>

      <div class="wishlist-page__summary" aria-live="polite">
        <span class="wishlist-page__summary-label">Items saved</span>
        <div class="wishlist-page__summary-value">
          <span class="js-wishlist-page-count">0</span>
          <small>products</small>
        </div>
      </div>
    </header>

    <div class="wishlist-page__body">
      <div class="wishlist-page__actions">
        <a href="/collections/all" class="btn btn-theme gradient-theme-vertical">Continue shopping</a>
        <a href="/search" class="btn btn-outline-secondary">Search products</a>
      </div>

      <div class="js-wishlist-content wishlist-page__grid" aria-live="polite"></div>
    </div>
  </div>
</section>
