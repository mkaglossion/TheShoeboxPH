<!-- service.liquid -->

<style>
  .customstyle{{ section.id }} .iconx8 svg, .customstyle{{ section.id }} .iconx8 .icon, .customstyle{{ section.id }} .iconx8 [class^=icon-]{
      width: {{section.settings.size}}px;
      height: {{section.settings.size}}px;
      font-size: {{section.settings.size}}px;
    }
  .sv-bgsub-{{ section.id }}{
    position:relative;
  }
  .sv-bgsub-{{ section.id }}:before{
    content: "";
    display: block;
    width: 200%;
    height: 100%;
    z-index: 0;
    left: 0;
    right: auto;
    top: 0;
    position: absolute;
    background: {{section.settings.bgsectionsub}};
  }
  @media (max-width: 990px){
    .sv-bgsub-{{ section.id }}{
      padding: 30px !important;
    }
  }
  {%- if section.settings.layout == 'style-3' -%}
  @media (min-width: 991px){
      .block-sv3 .services-wrapper{
        padding: 0 90px;
      }
      .block-sv3 .services-slider{
        margin:0 -45px;
      }
      .block-sv3 .services-item{
        padding:0 45px;
      }
    }
  {%- endif -%}
  {%- if section.settings.layout == 'style-4' -%}
  .service-4{
    align-items: center;
  }
  @media (min-width: 991px){
      .service-4:before{
        content: "";
      background: rgba(0,0,0,.1);
      width: 60px;
      height: 1px;
      display: inline-block;
      vertical-align: middle;
      margin-right: 25px;
      }
  }
  {%- endif -%}
</style>
<div class="customstyle{{ section.id }} {% if section.settings.layout == 'style-3' %} block-sv3 {% endif %}" data-aos="{{section.settings.animation}}" >
  {%- include 'style-section' -%}
<div class="{{ section.settings.setwidth }}">
  <div class="section-block sv-bgsub-{{ section.id }}" style="padding:{{section.settings.paddingbox}}">
    {%- include 'section-heading' -%}
    <div class="services-wrapper dots-negative">
      <div class="services-slider row mb-0" id="service-list-{{ section.id }}"
           data-rows="{{section.settings.rows}}"
           data-slidesToShow="{{section.blocks.size}}"
           data-slidestoscroll="{{section.blocks.size}}"
           data-arrows="{{ section.settings.arrows }}"
           data-dots="{{ section.settings.dots }}" 
           data-draggable="{{ section.settings.draggable }}" 
           data-infinite="{{ section.settings.infinite }}" 
           data-section-id="{{ section.id }}" 
           data-section-type="slickCarousels">
        {%- for block in section.blocks -%}
        <div class="col services-item carousel__slide-wrapper--{{block.id}}" {{ block.shopify_attributes }}>
          {%- case section.settings.layout -%}
          {%- when 'style-1' -%}
          <div class="media service-1 text-left px-4 py-5" style="background-color:{{block.settings.bgblock}};">
            <span class=" mr-4 iconx8" style="color:{{section.settings.iconcolor}};">
              {{block.settings.icon | default:'[[ Icon ]]'}}
            </span>
            <div class="media-body">
              {%- if block.settings.title != blank -%}
              <h6 class="mt-0 mb-2 h4" style="color:{{section.settings.titlecolor}};">{{block.settings.title}}</h6>
              {%- endif -%}
              <div style="color:{{section.settings.subcolor}};">{{block.settings.description}}</div>
            </div>
          </div>
          {%- when 'style-2' -%}
          <div class="media service-2 text-center">
            <div class="media-body py-5" style="background-color:{{block.settings.bgblock}};">
                <div class="mb-4 iconx8" style="color:{{section.settings.iconcolor}};">
                {{block.settings.icon | default:'[[ Icon ]]'}}
              </div>
              {%- if block.settings.title != blank -%}
                <h6 class="mt-0 mb-4 h4 text-uppercase" style="color:{{section.settings.titlecolor}};">{{block.settings.title}}</h6>
              {%- endif -%}
              <div style="color:{{section.settings.subcolor}};">{{block.settings.description}}</div>
            </div>
          </div>
          {%- when 'style-3' -%}
          <div class="media service-3 text-center">
              <div class="media-body py-3" style="background-color:{{block.settings.bgblock}};">
                <div class="py-5">
                  <div class="mb-4 iconx8" style="color:{{section.settings.iconcolor}};">
                  {{block.settings.icon | default:'[[ Icon ]]'}}
                </div>
                {%- if block.settings.title != blank -%}
                  <h6 class="mt-0 mb-2 h4 text-uppercase" style="color:{{section.settings.titlecolor}};">{{block.settings.title}}</h6>
                {%- endif -%}
                <div style="color:{{section.settings.subcolor}};">{{block.settings.description}}</div>
              </div>
            </div>
          </div>
          {%- when 'style-4' -%}
          <div class="media service-1 service-4 text-left py-5" style="background-color:{{block.settings.bgblock}};">
            <span class=" mr-4 iconx8" style="color:{{section.settings.iconcolor}};">
              {{block.settings.icon | default:'[[ Icon ]]'}}
            </span>
            <div class="media-body">
              <h6 class="mt-0 mb-2 h4" style="color:{{section.settings.titlecolor}};">{{block.settings.title}}</h6>
              <div style="color:{{section.settings.subcolor}};">{{block.settings.description}}</div>
            </div>
          </div>
          {%- endcase -%}
        </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.blocks.size == 0 -%}
    {%- include 'no-blocks' -%}
    {%- endif -%}
  </div>
</div>
</div>

