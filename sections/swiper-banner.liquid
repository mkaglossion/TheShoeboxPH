<!-- swiper-banner.liquid -->
<style>
  .swiper-banner-{{ section.id }} {
    background-color: {{ section.settings.bgsection }};
    margin: {{ section.settings.marginsection }};
    padding: {{ section.settings.paddingsection }};
    overflow: hidden;
  }

  .swiper-banner-{{ section.id }} .swiper-banner__viewport {
    position: relative;
    overflow: hidden;
  }

  .swiper-banner-{{ section.id }} .swiper-container {
    width: 100%;
    overflow: hidden;
  }

  .swiper-banner-{{ section.id }} .swiper-banner__slider {
    touch-action: pan-y;
    -ms-touch-action: pan-y;
    cursor: grab;
  }

  .swiper-banner-{{ section.id }} .swiper-banner__slider:active {
    cursor: grabbing;
  }

  .swiper-banner-{{ section.id }} .swiper-slide {
    line-height: 0;
  }

  .swiper-banner-{{ section.id }} .swiper-banner__link,
  .swiper-banner-{{ section.id }} .swiper-banner__picture {
    display: block;
    width: 100%;
  }

  .swiper-banner-{{ section.id }} .swiper-banner__image {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
    user-drag: none;
    user-select: none;
  }

  .swiper-banner-{{ section.id }} .swiper-banner__placeholder {
    min-height: 240px;
    background: #f2f2f2;
  }

  .swiper-banner-{{ section.id }} .swiper-pagination {
    position: absolute;
    bottom: 16px;
    left: 0;
    width: 100%;
    margin-top: 0;
    text-align: center;
    z-index: 2;
  }

  .swiper-banner-{{ section.id }} .swiper-button-prev,
  .swiper-banner-{{ section.id }} .swiper-button-next {
    width: 42px;
    height: 42px;
    margin-top: -21px;
    border-radius: 999px;
    background: rgba(231, 52, 53, 0.92);
    color: #fff;
    box-shadow: 0 6px 22px rgba(231, 52, 53, 0.28);
    transition: transform 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
  }

  .swiper-banner-{{ section.id }} .swiper-button-prev:hover,
  .swiper-banner-{{ section.id }} .swiper-button-next:hover {
    background: rgba(231, 52, 53, 1);
  }

  .swiper-banner-{{ section.id }} .swiper-button-prev:after,
  .swiper-banner-{{ section.id }} .swiper-button-next:after {
    font-size: 14px;
    font-weight: 700;
  }

  .swiper-banner-{{ section.id }} .swiper-button-prev {
    left: 16px;
  }

  .swiper-banner-{{ section.id }} .swiper-button-next {
    right: 16px;
  }

  .swiper-banner-{{ section.id }} .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    opacity: 0.35;
    background: #e73435;
    transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease;
  }

  .swiper-banner-{{ section.id }} .swiper-pagination-bullet-active {
    opacity: 1;
    transform: scale(1.15);
    background: #e73435;
  }

  .swiper-banner-{{ section.id }}.swiper-banner--hide-dots .swiper-pagination,
  .swiper-banner-{{ section.id }}.swiper-banner--hide-arrows .swiper-button-prev,
  .swiper-banner-{{ section.id }}.swiper-banner--hide-arrows .swiper-button-next {
    display: none;
  }

  @media (max-width: 749px) {
    .swiper-banner-{{ section.id }} {
      margin: {{ section.settings.marginmobile }};
      padding: {{ section.settings.paddingmobile }};
    }

    .swiper-banner-{{ section.id }} .swiper-pagination {
      bottom: 10px;
    }
  }
</style>

<section
  class="customstyle{{ section.id }} swiper-banner swiper-banner-{{ section.id }}{% unless section.settings.dots %} swiper-banner--hide-dots{% endunless %}{% unless section.settings.arrows %} swiper-banner--hide-arrows{% endunless %}"
  data-aos="{{ section.settings.animation }}"
  data-section-id="{{ section.id }}"
  data-section-type="swiperbanner"
  data-autoplay="{{ section.settings.autoplay }}"
  data-delay="{{ section.settings.delay }}"
  data-speed="{{ section.settings.speed }}"
  data-loop="{{ section.settings.loop }}"
  data-arrows="{{ section.settings.arrows }}"
  data-dots="{{ section.settings.dots }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
>
  {%- include 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    {%- if section.settings.title != blank or section.settings.des != blank -%}
      <div class="section-block pb-3">
        {%- if section.settings.title != blank -%}
          <h2 class="section-title mb-2">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.des != blank -%}
          <div class="section-description">{{ section.settings.des }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="swiper-banner__viewport">
      <div
        class="swiper-container swiper-banner__slider"
        id="SwiperBanner-{{ section.id }}"
      >
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- assign desktop_image = block.settings.desktop_image -%}
            {%- assign mobile_image = block.settings.mobile_image | default: block.settings.desktop_image -%}
            {%- assign slide_link = block.settings.link -%}
            <div
              class="swiper-slide"
              data-block-id="{{ block.id }}"
              data-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {%- if desktop_image != blank -%}
                {%- if slide_link != blank -%}
                  <a
                    class="swiper-banner__link"
                    href="{{ slide_link }}"
                    draggable="false"
                    {%- if block.settings.open_new_tab -%} target="_blank" rel="noopener noreferrer"{%- endif -%}
                  >
                {%- else -%}
                  <div class="swiper-banner__link">
                {%- endif -%}
                  <picture class="swiper-banner__picture">
                    {%- if block.settings.mobile_image != blank -%}
                      <source media="(max-width: 749px)" srcset="{{ mobile_image | img_url: '2048x' }}">
                    {%- endif -%}
                    <img
                      class="swiper-banner__image"
                      src="{{ desktop_image | img_url: '2048x' }}"
                      alt="{{ block.settings.alt_text | default: desktop_image.alt | escape }}"
                      draggable="false"
                      {%- if forloop.first -%}
                        loading="eager"
                        fetchpriority="high"
                      {%- else -%}
                        loading="lazy"
                      {%- endif -%}
                    >
                  </picture>
                {%- if slide_link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg swiper-banner__placeholder' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="swiper-pagination" aria-hidden="{% if section.settings.dots %}false{% else %}true{% endif %}"></div>
        <div class="swiper-button-prev" aria-hidden="{% if section.settings.arrows %}false{% else %}true{% endif %}"></div>
        <div class="swiper-button-next" aria-hidden="{% if section.settings.arrows %}false{% else %}true{% endif %}"></div>
      </div>
    </div>

    {%- if section.blocks.size == 0 -%}
      {%- include 'no-blocks' -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Swiper banner",
  "class": "index-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "fade-down", "label": "Fade Down" },
        { "value": "fade-left", "label": "Fade Left" },
        { "value": "fade-right", "label": "Fade Right" },
        { "value": "zoom-in", "label": "Zoom In" },
        { "value": "zoom-out", "label": "Zoom Out" }
      ],
      "label": "Select Animation"
    },
    {
      "type": "text",
      "id": "paddingsection",
      "label": "Padding Section",
      "default": "0px 0px 0px 0px",
      "info": "Padding: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "paddingmobile",
      "label": "Padding Section Mobile",
      "default": "0px 0px 0px 0px",
      "info": "Padding: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "marginsection",
      "label": "Margin Section",
      "default": "0px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "marginmobile",
      "label": "Margin Mobile",
      "default": "0px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    },
    {
      "type": "color",
      "id": "bgsection",
      "label": "Background Section",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Full Width",
      "default": "full",
      "options": [
        { "value": "container", "label": "Box" },
        { "value": "container-fluid", "label": "Container Fluid" },
        { "value": "full", "label": "Full" }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Swiper banner"
    },
    {
      "type": "textarea",
      "id": "des",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Autoplay Delay",
      "min": 1000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "default": 3000
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Transition Speed",
      "min": 200,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause On Hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "banner_slide",
      "name": "Banner slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swiper banner",
      "category": "Image",
      "blocks": [
        {
          "type": "banner_slide"
        }
      ]
    }
  ]
}
{% endschema %}
