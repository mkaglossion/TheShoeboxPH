{% comment %} Vio-motion Support custom section - configurable cards with logo, title, description and CTA {% endcomment %}
<section class="vio-motion-support" aria-labelledby="vio-motion-support-title-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Tenor+Sans&display=swap');

    #shopify-section-{{ section.id }} .vio-motion-support {
      --vio-support-text: #1f1f1f;
      --vio-support-muted: #555555;
      --vio-support-border: #666666;
      font-family: "Tenor Sans", sans-serif;
      background: {{ section.settings.bg_color }};
      padding: clamp(44px, 7vw, 92px) 16px clamp(42px, 6vw, 72px);
    }

    #shopify-section-{{ section.id }} .vio-motion-support__inner {
      max-width: 1200px;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__title {
      margin: 0 0 clamp(26px, 4.5vw, 56px);
      font-weight: 300;
      font-synthesis: none;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-size: clamp(18px, 1.05rem + 1vw, 31px);
      color: {{ section.settings.title_color }};
      text-align: center;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(260px, 1fr));
      gap: clamp(34px, 6vw, 96px) clamp(34px, 5vw, 82px);
      justify-items: center;
      align-items: start;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__card {
      max-width: 500px;
      padding: 0 4px;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__logo-wrap {
      min-height: 126px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 0 16px;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__logo {
      display: block;
      width: 100%;
      max-width: 240px;
      max-height: 116px;
      height: auto;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__logo-fallback {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      max-width: 240px;
      min-height: 76px;
      padding: 12px 18px;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 999px;
      color: {{ section.settings.heading_color }};
      font-size: 12px;
      line-height: 1.3;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__card-title {
      margin: 4px 0 12px;
      font-weight: 400;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: clamp(15px, 0.88rem + 0.35vw, 18px);
      color: {{ section.settings.heading_color }};
    }

    #shopify-section-{{ section.id }} .vio-motion-support__description {
      margin: 0 auto 22px;
      max-width: 450px;
      font-size: 15px;
      font-weight: 400;
      line-height: 1.65;
      color: var(--vio-support-muted);
    }

    #shopify-section-{{ section.id }} .vio-motion-support__button {
      display: inline-block;
      min-width: 160px;
      padding: 12px 28px;
      border: 1px solid var(--vio-support-border);
      color: var(--vio-support-text);
      background: transparent;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-weight: 400;
      font-size: 13px;
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }

    #shopify-section-{{ section.id }} .vio-motion-support__button:hover,
    #shopify-section-{{ section.id }} .vio-motion-support__button:focus-visible {
      background: var(--vio-support-border);
      color: #ffffff;
      border-color: var(--vio-support-border);
    }

    @media (max-width: 1024px) {
      #shopify-section-{{ section.id }} .vio-motion-support__grid {
        gap: clamp(28px, 5vw, 56px) clamp(24px, 4vw, 48px);
      }

      #shopify-section-{{ section.id }} .vio-motion-support__logo-wrap {
        min-height: 100px;
      }
    }

    @media (max-width: 820px) {
      #shopify-section-{{ section.id }} .vio-motion-support__grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      #shopify-section-{{ section.id }} .vio-motion-support__logo-wrap {
        min-height: 92px;
      }

      #shopify-section-{{ section.id }} .vio-motion-support__title {
        letter-spacing: 0.2em;
        font-size: clamp(16px, 1rem + 1vw, 23px);
      }

      #shopify-section-{{ section.id }} .vio-motion-support__description {
        padding: 0 12px;
        max-width: 620px;
      }

      #shopify-section-{{ section.id }} .vio-motion-support__button {
        display: block;
        width: 70%;
        margin: 12px auto 0;
      }
    }

    @media (max-width: 480px) {
      #shopify-section-{{ section.id }} .vio-motion-support {
        padding: clamp(20px, 6vw, 42px) 12px clamp(32px, 7vw, 48px);
      }

      #shopify-section-{{ section.id }} .vio-motion-support__logo-wrap {
        min-height: 80px;
      }

      #shopify-section-{{ section.id }} .vio-motion-support__title {
        letter-spacing: 0.18em;
        font-size: clamp(14px, 0.95rem, 20px);
      }

      #shopify-section-{{ section.id }} .vio-motion-support__card-title {
        font-size: 14px;
        letter-spacing: 0.14em;
      }

      #shopify-section-{{ section.id }} .vio-motion-support__description {
        font-size: 14px;
        padding: 0 6px;
      }

      #shopify-section-{{ section.id }} .vio-motion-support__button {
        width: 84%;
        padding: 10px 18px;
        min-width: 0;
      }
    }
  </style>

  <div class="vio-motion-support__inner">
    <h2 id="vio-motion-support-title-{{ section.id }}" class="vio-motion-support__title">
      {{ section.settings.section_heading | escape }}
    </h2>

    <div class="vio-motion-support__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article id="vio-motion-support-card-{{ block.id }}" class="vio-motion-support__card" {{ block.shopify_attributes }}>
            <div class="vio-motion-support__logo-wrap">
              {% if block.settings.logo_image != blank %}
                <img
                  class="vio-motion-support__logo"
                  src="{{ block.settings.logo_image | img_url: 'master' }}"
                  alt="{{ block.settings.logo_alt | escape }}"
                >
              {% elsif block.settings.logo_image_url != blank %}
                <img
                  class="vio-motion-support__logo"
                  src="{{ block.settings.logo_image_url | escape }}"
                  alt="{{ block.settings.logo_alt | escape }}"
                >
              {% else %}
                <span class="vio-motion-support__logo-fallback">{{ block.settings.logo_alt | escape }}</span>
              {% endif %}
            </div>

            <h3 class="vio-motion-support__card-title">{{ block.settings.card_title | escape }}</h3>

            {% if block.settings.card_text != blank %}
              <p class="vio-motion-support__description">{{ block.settings.card_text | escape | newline_to_br }}</p>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="vio-motion-support__button"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {{ block.settings.button_text | escape }}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        {% if shopify.design_mode %}
          <div style="max-width:720px;margin:0 auto;padding:28px 12px;border:1px dashed #ddd;color:#666;">
            <strong style="display:block;margin-bottom:6px;">Vio-motion Support - add cards</strong>
            <div style="font-size:14px;line-height:1.4">
              Add 1-4 cards in the section settings. Each card can include a logo image, title, short description, and an optional CTA button.
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vio-motion Support",
  "class": "index-section vio-motion-support-section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Vio-motion Support"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Card heading color",
      "default": "#1f1f1f"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_image_url",
          "label": "Logo image URL (fallback)"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo alt text",
          "default": "Logo"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card title",
          "default": "Trusted by Podiatric Specialist"
        },
        {
          "type": "textarea",
          "id": "card_text",
          "label": "Description",
          "default": "Short description text for this card."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Learn More"
        },
        {
          "type": "text",
          "id": "button_link",
          "label": "Button link (paste full URL)",
          "default": "/"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Vio-motion Support",
      "settings": {
        "section_heading": "TRUSTED AND APPROVED BY EXPERTS",
        "bg_color": "#fefefe",
        "title_color": "#1f1f1f",
        "heading_color": "#1f1f1f"
      },
      "blocks": [
        {
          "type": "card",
          "settings": {
            "logo_alt": "American Podiatric Medical Association Seal of Acceptance",
            "card_title": "Trusted by Podiatric Specialist",
            "card_text": "The American Podiatric Medical Association is the leading resource for foot health information. Many Vionic products carry the APMA Seal of Acceptance.",
            "button_text": "Learn More",
            "button_link": "https://vionicshoes.com.ph/pages/apma",
            "open_in_new_tab": false
          }
        },
        {
          "type": "card",
          "settings": {
            "logo_alt": "VioLab",
            "card_title": "The Source of Our Innovation",
            "card_text": "Vionic benefits from the expertise of some of the finest minds in health and lower limb biomechanics with our VioLab.",
            "button_text": "Learn More",
            "button_link": "https://vionicshoes.com.ph/pages/violab",
            "open_in_new_tab": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
