        "html_NUHFak": {
          "type": "html",
          "settings": {
            "code": "<body>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>THE SHOEBOX OUTLET STORE</title>\n  <style>\n    @font-face {\n      font-family: 'Interstate Black Cond';\n      src: url('https://example.com/fonts/Interstate-Black-Cond.woff2') format('woff2'),\n           url('https://example.com/fonts/Interstate-Black-Cond.woff') format('woff');\n      font-weight: 900;\n      font-style: normal;\n      font-display: swap;\n    }\n\n    /* --------------- Reset & Base Styles --------------- */\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: \"Interstate Black Cond\", sans-serif !important;\n      color: #222;\n      background-color: #f9f9f9;\n      line-height: 1.5;\n    }\n\n    a {\n      text-decoration: none;\n      color: inherit;\n      cursor: pointer;\n      transition: color 0.3s ease;\n    }\n    a:hover {\n      color: #e02b20;\n    }\n\n    /* --------------- Footer Container --------------- */\n    .footer {\n      background-color: #fff;\n      border-top: 1px solid #ddd;\n      padding: 60px 20px;\n      transition: padding 0.3s ease;\n    }\n\n    .footer-inner {\n      max-width: 1200px;\n      margin: 0 auto;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 40px; /* Increased gap between logo and info columns */\n      align-items: flex-start;\n      transition: gap 0.3s ease;\n    }\n\n    /* --------------- Brand / Logo --------------- */\n    .brand-section {\n      flex: 0 0 280px;\n      text-align: left;\n      transition: flex 0.3s ease;\n      margin-right: 20px; /* Added margin to create space between logo and columns */\n    }\n\n    .brand-section a {\n      display: inline-block;\n      max-width: 100%;\n    }\n\n    .brand-section img {\n      width: 100%;\n      height: auto;\n      max-width: 280px; /* Added max-width for better control */\n      transition: transform 0.3s ease;\n    }\n    .brand-section img:hover,\n    .brand-section img:active {\n      transform: scale(1.05);\n    }\n\n    /* --------------- Info Columns --------------- */\n    .info-columns {\n      display: flex;\n      flex: 1;\n      flex-wrap: wrap;\n      gap: 40px; /* Increased gap between columns */\n      transition: gap 0.3s ease;\n    }\n\n    .info-column {\n      flex: 1;\n      min-width: 200px;\n    }\n\n    /* --------------- Column Titles --------------- */\n    .column-title {\n      font-family: \"Interstate Black Cond\", sans-serif !important;\n      font-weight: 600 !important;\n      font-style: normal !important;\n      font-size: 18px;\n      letter-spacing: 0.1em;\n      line-height: 1.2;\n      margin-bottom: 12px;\n      color: #333;\n      position: relative;\n      padding-bottom: 6px;\n      text-align: left;\n    }\n\n    .column-title::after {\n  content: \"\";\n  display: block;\n  width: 50px;\n  height: 2px;\n  background-color: #e02b20;\n  margin-top: 4px;\n  margin-left: 0; /* Ensures left alignment */\n}\n\n\n    /* --------------- Info Text --------------- */\n    .info-text {\n      font-size: 14px;\n      margin-bottom: 10px;\n      color: #555;\n      line-height: 1.6; /* Increased line height for better readability */\n    text-align: left;\n    }\n    .info-text:last-child {\n      margin-bottom: 0;\n    }\n    .opening-hours {\n      margin-top: 8px;\n    }\n\n    /* --------------- Social Icons --------------- */\n    .social-icons {\n      margin-top: 20px; /* Increased margin above icons */\n      display: flex;\n      gap: 12px;\n      transition: margin 0.3s ease;\n    }\n    .social-icons a {\n      width: 32px;\n      height: 32px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      background-color: #222;\n      border-radius: 50%;\n      color: #fff;\n      font-size: 16px;\n      transition: background-color 0.3s ease, transform 0.1s ease;\n    }\n    .social-icons a:hover,\n    .social-icons a:active {\n      background-color: #e02b20;\n      transform: scale(1.1);\n    }\n\n    /* --------------- Responsive (Mobile) --------------- */\n    @media (max-width: 768px) {\n      .footer {\n        padding: 40px 20px; /* Adjusted padding for better mobile spacing */\n      }\n\n      .footer-inner {\n        flex-direction: column;\n        gap: 30px; /* Adjusted gap for mobile */\n      }\n\n      .brand-section {\n        margin: 0 auto 20px; /* Added bottom margin for mobile */\n        text-align: center;\n        flex: 0 0 auto;\n      }\n      .brand-section img {\n        max-width: 240px;\n      }\n\n      .info-columns {\n        flex-direction: column;\n        gap: 30px; /* Adjusted gap between columns for mobile */\n      }\n\n      .info-column {\n        text-align: center; /* Center align content on mobile */\n      }\n      \n      .column-title::after {\n        margin: 4px auto 0; /* Center the underline on mobile */\n        margin-left: 0; /* Ensures left alignment */\n      }\n\n      .social-icons {\n        margin: 20px auto 0; /* Adjusted margin for mobile */\n        justify-content: center;\n      }\n    }\n\n    /* Medium screens (tablets) */\n    @media (min-width: 769px) and (max-width: 1024px) {\n      .footer-inner {\n        gap: 30px; /* Adjusted gap for tablets */\n      }\n      \n      .info-columns {\n        gap: 30px; /* Adjusted column gap for tablets */\n      }\n      \n      .brand-section {\n        flex: 0 0 240px; /* Slightly smaller logo area */\n      }\n    }\n  </style>\n\n  <footer class=\"footer\">\n    <div class=\"footer-inner\">\n      <!-- Logo / Brand -->\n      <div class=\"brand-section\">\n        <a href=\"https://www.theshoeboxoutlet.com.ph/\" aria-label=\"Go to home page\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0934/7537/3367/files/The_Shoebox_Outlet_Store.png?v=1748222277\" alt=\"The Shoebox Outlet Store Logo\">\n        </a>\n        <p style=\"font-size:12px; color:#777; margin-top:6px;\">Quality Shoes, Great Prices</p>\n        <div class=\"social-icons\">\n          <a href=\"https://www.facebook.com/YourPage\" aria-label=\"Facebook\" target=\"_blank\" rel=\"noopener\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M22.675 0h-21.35C.597 0 0 .597 0 1.333v21.333C0 23.403.597 24 1.325 24h11.495v-9.294H9.691v-3.622h3.129V8.414c0-3.1 1.892-4.788 4.657-4.788 1.325 0 2.464.098 2.797.143v3.24l-1.918.001c-1.504 0-1.796.715-1.796 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.728 0 1.325-.597 1.325-1.334V1.333C24 .597 23.403 0 22.675 0z\"></path>\n            </svg>\n          </a>\n          <a href=\"https://www.instagram.com/YourProfile\" aria-label=\"Instagram\" target=\"_blank\" rel=\"noopener\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.343 3.608 1.319.974.975 1.257 2.242 1.319 3.608.058 1.266.069 1.646.069 4.85 0 3.204-.012 3.584-.07 4.85-.062 1.366-.343 2.633-1.319 3.608-.975.974-2.242 1.256-3.608 1.319-1.266.058-1.646.069-4.85.069-3.204 0-3.584-.012-4.85-.07-1.366-.062-2.633-.343-3.608-1.319-.974-.975-1.256-2.242-1.319-3.608C2.174 15.584 2.163 15.204 2.163 12c0-3.204.012-3.584.07-4.85.062-1.366.343-2.633 1.319-3.608C4.527 2.576 5.794 2.295 7.16 2.233 8.426 2.175 8.806 2.163 12 2.163zm0-2.163C8.741 0 8.332.013 7.052.072 5.78.131 4.672.43 3.762 1.34 2.853 2.25 2.554 3.359 2.495 4.631 2.436 5.911 2.424 6.32 2.424 12c0 5.68.013 6.089.071 7.369.059 1.272.358 2.381 1.268 3.291.91.909 2.018 1.208 3.29 1.267 1.28.058 1.689.071 7.369.071 5.68 0 6.089-.013 7.368-.071 1.272-.059 2.38-.358 3.29-1.267.91-.91 1.208-2.019 1.267-3.291.058-1.28.071-1.689.071-7.369 0-5.68-.013-6.089-.071-7.369-.059-1.272-.358-2.381-1.267-3.29-.91-.91-2.018-1.209-3.29-1.268C18.089.013 17.68 0 12 0z\"></path>\n              <path d=\"M12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a3.999 3.999 0 1 1 0-7.998 3.999 3.999 0 0 1 0 7.998z\"></path>\n              <circle cx=\"18.406\" cy=\"5.594\" r=\"1.44\"></circle>\n            </svg>\n          </a>\n          <a href=\"https://www.tiktok.com/@YourProfile\" aria-label=\"TikTok\" target=\"_blank\" rel=\"noopener\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z\"></path>\n            </svg>\n          </a>\n        </div>\n      </div>\n\n      <!-- Info Columns -->\n      <div class=\"info-columns\">\n        <div class=\"info-column\">\n          <h2 class=\"column-title\">Online Store</h2>\n          <div class=\"opening-hours\">\n            <p class=\"info-text\">Monday to Sunday</p>\n          </div>\n        </div>\n        <div class=\"info-column\">\n          <h2 class=\"column-title\">Location</h2>\n          <p class=\"info-text\">#107 Manila Bay Spinning Mills</p>\n          <p class=\"info-text\">Compound Shoemaker's Group </p>\n<p class=\"info-text\">Warehouse, Brgy. Jesus Dela Peña,</p>\n          <p class=\"info-text\">Marikina City, Philippines 1803</p>\n        </div>\n        <div class=\"info-column\">\n          <h2 class=\"column-title\">Contacts</h2>\n          <p class=\"info-text\"><a href=\"tel:+639177013367\">+63-917-701-3367</a></p>\n          <p class=\"info-text\"><a href=\"tel:+639177018367\">+63-917-701-8367</a></p>\n<p class=\"info-text\"><a href=\"tel:+639171023218\">+63-917-102-3218</a></p>\n\n          <p class=\"info-text\"><a href=\"mailto:customerservice@shoeboxoutlet.com.ph\">customerservice@shoeboxoutlet.com.ph</a></p>\n        </div>\n      </div>\n    </div>\n  </footer>\n</body>",
            "width": "100%",
