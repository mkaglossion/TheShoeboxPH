{"sections":{"main":{"type":"main-page","custom_css":[],"settings":{}},"advanced_content_NqHUzQ":{"type":"advanced-content","blocks":{"html_wU8CVk":{"type":"html","settings":{"code":"<body>\n\n\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Responsive Brand Logos<\/title>\n  <style>\n    \/* Container: responsive grid of logos *\/\n    .brand-logos {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));\n      gap: 1rem;\n      align-items: center;\n      justify-items: center;\n      padding: 1rem;\n    }\n\n    \/* Each logo wrapper *\/\n    .brand-logo {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      max-height: 80px;\n      width: 100%;\n      overflow: hidden;\n    }\n\n    \/* Logos themselves *\/\n    .brand-logo img {\n      max-width: 100%;\n      max-height: 100%;\n      height: auto;\n      width: auto;\n      object-fit: contain;\n      display: block;\n      transition: transform 0.3s ease, opacity 0.3s ease;\n    }\n\n    \/* Hover effect *\/\n    .brand-logo:hover img {\n      transform: scale(1.1);\n      opacity: 0.9;\n    }\n\n    \/* Mobile view: exactly 3 columns *\/\n    @media (max-width: 600px) {\n      .brand-logos {\n        grid-template-columns: repeat(3, 1fr);\n        gap: 0.5rem;\n      }\n      .brand-logo {\n        max-height: 60px;\n      }\n    }\n\n    \/* Very narrow screens: ensure spacing stays manageable *\/\n    @media (max-width: 400px) {\n      .brand-logos {\n        gap: 0.4rem;\n      }\n      .brand-logo {\n        max-height: 60px;\n      }\n    }\n\n    \/* On very wide screens, reduce logo size more *\/\n    @media (min-width: 1200px) {\n      .brand-logo {\n        max-height: 150px;\n      }\n    }\n  <\/style>\n\n\n  <!-- Brand Logos Section -->\n  <div class=\"brand-logos\">\n    <a href=\"\/pages\/hush-puppies-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/