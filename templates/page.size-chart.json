{"sections":{"advanced_content_NqHUzQ":{"type":"advanced-content","blocks":{"html_wU8CVk":{"type":"html","settings":{"code":"<body>\n\n\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Responsive Brand Logos<\/title>\n  <style>\n    \/* Container: responsive grid of logos *\/\n    .brand-logos {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));\n      gap: 1rem;\n      align-items: center;\n      justify-items: center;\n      padding: 1rem;\n    }\n\n    \/* Each logo wrapper *\/\n    .brand-logo {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      max-height: 80px;\n      width: 100%;\n      overflow: hidden;\n    }\n\n    \/* Logos themselves *\/\n    .brand-logo img {\n      max-width: 100%;\n      max-height: 100%;\n      height: auto;\n      width: auto;\n      object-fit: contain;\n      display: block;\n      transition: transform 0.3s ease, opacity 0.3s ease;\n    }\n\n    \/* Hover effect *\/\n    .brand-logo:hover img {\n      transform: scale(1.1);\n      opacity: 0.9;\n    }\n\n    \/* Mobile view: exactly 3 columns *\/\n    @media (max-width: 600px) {\n      .brand-logos {\n        grid-template-columns: repeat(3, 1fr);\n        gap: 0.5rem;\n      }\n      .brand-logo {\n        max-height: 60px;\n      }\n    }\n\n    \/* Very narrow screens: ensure spacing stays manageable *\/\n    @media (max-width: 400px) {\n      .brand-logos {\n        gap: 0.4rem;\n      }\n      .brand-logo {\n        max-height: 60px;\n      }\n    }\n\n    \/* On very wide screens, reduce logo size more *\/\n    @media (min-width: 1200px) {\n      .brand-logo {\n        max-height: 150px;\n      }\n    }\n  <\/style>\n\n\n  <!-- Brand Logos Section -->\n  <div class=\"brand-logos\">\n    <a href=\"\/pages\/hush-puppies-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/hp_logo.png?v=1748246470\" alt=\"Hush Puppies\">\n    <\/a>\n    <a href=\"\/pages\/kswiss-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/ks_logo.png?v=1748246470\" alt=\"K-Swiss\">\n    <\/a>\n    <a href=\"\/pages\/palladium-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/pl_logo.png?v=1748246470\" alt=\"Palladium\">\n    <\/a>\n    <a href=\"\/pages\/sebago-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/sb_logo.png?v=1748246470\" alt=\"Sebago\">\n    <\/a>\n    <a href=\"\/pages\/scholl-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/sc_logo.png?v=1748246470\" alt=\"Scholl\">\n    <\/a>\n    <a href=\"\/pages\/vionic-shoes\" class=\"brand-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/vc_l_ogo.png?v=1748246470\" alt=\"Vionic\">\n    <\/a>\n  <\/div>\n\n<\/body>","width":"100%","align":"auto"}}},"block_order":["html_wU8CVk"],"name":"Custom HTML","settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"0px 0px 0px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px 0px","zindex":"0","title_top":"Sub Title Top","title":"","des":"","setwidth":"full","padding":true,"col_center":false,"bgsection":"#fefefe","rangebg":0,"bgbefore":"rgba(0,0,0,0)","e_size":"auto","e_repeat":"no-repeat"}},"main":{"type":"main-page","custom_css":[],"settings":{}},"advanced_content_z8JaxX":{"type":"advanced-content","blocks":{"html_z8mb8c":{"type":"html","disabled":true,"settings":{"code":"<body>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>THE SHOEBOX OUTLET STORE<\/title>\n  <style>\n    @font-face {\n      font-family: 'Interstate Black Cond';\n      src: url('https:\/\/example.com\/fonts\/Interstate-Black-Cond.woff2') format('woff2'),\n           url('https:\/\/example.com\/fonts\/Interstate-Black-Cond.woff') format('woff');\n      font-weight: 900;\n      font-style: normal;\n      font-display: swap;\n    }\n\n    a {\n      text-decoration: none;\n      color: inherit;\n      cursor: pointer;\n      transition: color 0.3s ease;\n    }\n    a:hover {\n      color: #e02b20;\n    }\n\n    \/* --------------- Footer Container --------------- *\/\n    .footer {\n      background-color: #fff;\n      border-top: 1px solid #ddd;\n      padding: 60px 20px;\n      transition: padding 0.3s ease;\n    }\n\n    .footer-inner {\n      max-width: 1200px;\n      margin: 0 auto;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 40px; \/* Increased gap between logo and info columns *\/\n      align-items: flex-start;\n      transition: gap 0.3s ease;\n    }\n\n    \/* --------------- Brand \/ Logo --------------- *\/\n    .brand-section {\n      flex: 0 0 280px;\n      text-align: left;\n      transition: flex 0.3s ease;\n      margin-right: 20px; \/* Added margin to create space between logo and columns *\/\n    }\n\n    .brand-section a {\n      display: inline-block;\n      max-width: 100%;\n    }\n\n    .brand-section img {\n      width: 100%;\n      height: auto;\n      max-width: 280px; \/* Added max-width for better control *\/\n      transition: transform 0.3s ease;\n    }\n    .brand-section img:hover,\n    .brand-section img:active {\n      transform: scale(1.05);\n    }\n\n    \/* --------------- Info Columns --------------- *\/\n    .info-columns {\n      display: flex;\n      flex: 1;\n      flex-wrap: wrap;\n      gap: 40px; \/* Increased gap between columns *\/\n      transition: gap 0.3s ease;\n    }\n\n    .info-column {\n      flex: 1;\n      min-width: 200px;\n    }\n\n    \/* --------------- Column Titles --------------- *\/\n    .column-title {\n      font-family: \"Interstate Black Cond\", sans-serif !important;\n      font-weight: 600 !important;\n      font-style: normal !important;\n      font-size: 18px;\n      letter-spacing: 0.1em;\n      line-height: 1.2;\n      margin-bottom: 12px;\n      color: #333;\n      position: relative;\n      padding-bottom: 6px;\n      text-align: left;\n    }\n\n    .column-title::after {\n  content: \"\";\n  display: block;\n  width: 50px;\n  height: 2px;\n  background-color: #e02b20;\n  margin-top: 4px;\n  margin-left: 0; \/* Ensures left alignment *\/\n}\n\n\n    \/* --------------- Info Text --------------- *\/\n    .info-text {\n      font-size: 14px;\n      margin-bottom: 10px;\n      color: #555;\n      line-height: 1.6; \/* Increased line height for better readability *\/\n    text-align: left;\n    }\n    .info-text:last-child {\n      margin-bottom: 0;\n    }\n    .opening-hours {\n      margin-top: 8px;\n    }\n\n    \/* --------------- Social Icons --------------- *\/\n    .social-icons {\n      margin-top: 20px; \/* Increased margin above icons *\/\n      display: flex;\n      gap: 12px;\n      transition: margin 0.3s ease;\n    }\n    .social-icons a {\n      width: 32px;\n      height: 32px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      background-color: #222;\n      border-radius: 50%;\n      color: #fff;\n      font-size: 16px;\n      transition: background-color 0.3s ease, transform 0.1s ease;\n    }\n    .social-icons a:hover,\n    .social-icons a:active {\n      background-color: #e02b20;\n      transform: scale(1.1);\n    }\n\n    \/* --------------- Responsive (Mobile) --------------- *\/\n    @media (max-width: 768px) {\n      .footer {\n        padding: 40px 20px; \/* Adjusted padding for better mobile spacing *\/\n      }\n\n      .footer-inner {\n        flex-direction: column;\n        gap: 30px; \/* Adjusted gap for mobile *\/\n      }\n\n      .brand-section {\n        margin: 0 auto 20px; \/* Added bottom margin for mobile *\/\n        text-align: center;\n        flex: 0 0 auto;\n      }\n      .brand-section img {\n        max-width: 240px;\n      }\n\n      .info-columns {\n        flex-direction: column;\n        gap: 30px; \/* Adjusted gap between columns for mobile *\/\n      }\n\n      .info-column {\n        text-align: center; \/* Center align content on mobile *\/\n      }\n      \n      .column-title::after {\n        margin: 4px auto 0; \/* Center the underline on mobile *\/\n        margin-left: 0; \/* Ensures left alignment *\/\n      }\n\n      .social-icons {\n        margin: 20px auto 0; \/* Adjusted margin for mobile *\/\n        justify-content: center;\n      }\n    }\n\n    \/* Medium screens (tablets) *\/\n    @media (min-width: 769px) and (max-width: 1024px) {\n      .footer-inner {\n        gap: 30px; \/* Adjusted gap for tablets *\/\n      }\n      \n      .info-columns {\n        gap: 30px; \/* Adjusted column gap for tablets *\/\n      }\n      \n      .brand-section {\n        flex: 0 0 240px; \/* Slightly smaller logo area *\/\n      }\n    }\n  <\/style>\n\n  <footer class=\"footer\">\n    <div class=\"footer-inner\">\n      <!-- Logo \/ Brand -->\n      <div class=\"brand-section\">\n        <a href=\"https:\/\/www.theshoeboxoutlet.com.ph\/\" aria-label=\"Go to home page\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0934\/7537\/3367\/files\/The_Shoebox_Outlet_Store.png?v=1748222277\" alt=\"The Shoebox Outlet Store Logo\">\n        <\/a>\n        <p style=\"font-size:12px; color:#777; margin-top:6px;\">Quality Shoes, Great Prices<\/p>\n        <div class=\"social-icons\">\n          <a href=\"https:\/\/www.facebook.com\/YourPage\" aria-label=\"Facebook\" target=\"_blank\" rel=\"noopener\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n              <path d=\"M22.675 0h-21.35C.597 0 0 .597 0 1.333v21.333C0 23.403.597 24 1.325 24h11.495v-9.294H9.691v-3.622h3.129V8.414c0-3.1 1.892-4.788 4.657-4.788 1.325 0 2.464.098 2.797.143v3.24l-1.918.001c-1.504 0-1.796.