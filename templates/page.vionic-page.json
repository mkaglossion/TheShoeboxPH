        "html_pVUE6g": {
          "type": "html",
          "settings": {
            "code": "<body>\n\n\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Client Testimonials</title>\n  <style>\n    /* Reset & Global */\n    *, *::before, *::after {\n      box-sizing: border-box;\n    }\n    body {\n      margin: 0;\n      font-family: 'Inter', sans-serif;\n      background-color: #ffffff;\n      color: #e1e1e1;\n      line-height: 1.6;\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n    .logo {\n      font-weight: 700;\n      font-size: 1.5rem;\n      color: #8e8ee7;\n      letter-spacing: 0.05em;\n    }\n    nav {\n      display: none;\n    }\n    .hamburger {\n      font-size: 2.5rem;\n      color: #8e8ee7;\n      cursor: pointer;\n      user-select: none;\n    }\n\n    /* Mobile Nav Panel */\n    .nav-panel {\n      position: fixed;\n      top: 0; left: 0;\n      width: 100vw;\n      height: 100vh;\n      background-color: #121212e0;\n      backdrop-filter: blur(5px);\n      transform: translateX(-100%);\n      transition: transform 0.3s ease;\n      display: flex;\n      flex-direction: column;\n      padding: 3rem 2rem;\n      gap: 2rem;\n      z-index: 150;\n    }\n    .nav-panel.show {\n      transform: translateX(0);\n    }\n    .nav-close {\n      align-self: flex-end;\n      font-size: 2rem;\n      cursor: pointer;\n      color: #8e8ee7;\n    }\n    .nav-links {\n      display: flex;\n      flex-direction: column;\n      gap: 1.5rem;\n      font-weight: 600;\n      font-size: 1.25rem;\n      color: #cfcfe3;\n    }\n    .nav-links a {\n      color: inherit;\n      text-decoration: none;\n      transition: color 0.3s ease;\n    }\n    .nav-links a:hover,\n    .nav-links a:focus {\n      color: #8e8ee7;\n      outline: none;\n    }\n\n    /* Main Section */\n    main1 {\n      flex-grow: 1;\n      padding: 4rem 2rem 6rem;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      max-width: 1440px;\n      margin: 0 auto;\n      width: 100%;\n    }\n\n    h1.section-title {\n      font-weight: 600;\n      font-size: 2.5rem;\n      margin-bottom: 4rem;\n      color: #000000;\n      text-align: center;\n      max-width: 600px;\n    }\n\n    /* Testimonials Container */\n    .testimonials {\n      width: 100%;\n      display: grid;\n      gap: 3rem;\n      padding: 0 1rem;\n    }\n\n    /* Mobile: single column */\n    @media (max-width: 767px) {\n      nav {\n        display: none;\n      }\n      .testimonials {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    /* Desktop and up: three columns */\n    @media (min-width: 768px) and (max-width: 1439px) {\n      nav {\n        display: block;\n      }\n      .nav-panel {\n        display: none !important;\n      }\n      .testimonials {\n        grid-template-columns: repeat(3, 1fr);\n      }\n    }\n\n    /* Large desktop and up: wide 3 column + max width */\n    @media (min-width: 1440px) {\n      nav {\n        display: block;\n      }\n      .nav-panel {\n        display: none !important;\n      }\n      main1 {\n        padding: 4rem 3rem 6rem;\n      }\n      .testimonials {\n        grid-template-columns: repeat(3, 1fr);\n        max-width: 1200px;\n        margin: 0 auto;\n      }\n    }\n\n    /* Single testimonial card */\n    .testimonial {\n      background-color: #ffffff;\n      border-radius: 16px;\n      padding: 2.5rem 2rem 2.5rem 2rem;\n      display: flex;\n      flex-direction: column;\n      gap: 1.5rem;\n      box-shadow: 0 10px 25px rgb(0 0 0 / 0.4);\n      transition: box-shadow 0.3s ease;\n    }\n    .testimonial:hover,\n    .testimonial:focus-within {\n      box-shadow: 0 12px 40px rgb(142 142 231 / 0.6);\n    }\n\n    /* Author & Info */\n    .author-info {\n      display: flex;\n      align-items: center;\n      gap: 1rem;\n    }\n    .author-image {\n      width: 56px;\n      height: 56px;\n      border-radius: 50%;\n      overflow: hidden;\n      flex-shrink: 0;\n      box-shadow: 0 0 0 3px #333 inset;\n    }\n    .author-image img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n    .author-name {\n      font-weight: 600;\n      font-size: 1.1rem;\n      color: #000000;\n      margin: 0;\n    }\n    .author-location {\n      font-weight: 400;\n      font-size: 0.875rem;\n      color: #3a3939;\n      margin-top: 2px;\n      user-select: none;\n    }\n\n    /* Testimonial text */\n    .testimonial-text {\n      font-size: 1rem;\n      color: #333;\n      line-height: 1.55;\n      flex-grow: 1;\n      user-select: text;\n    }\n  </style>\n\n\n  <main1>\n    <h1 class=\"section-title\">What Our Customer Say</h1>\n    <section class=\"testimonials\" aria-label=\"Client testimonials\">\n      <article class=\"testimonial\" tabindex=\"0\">\n        <div class=\"author-info\">\n          <div class=\"author-image\">\n            <img src=\"https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/a5606a7d-b926-47aa-b9da-481d192fa3ef.png\" alt=\"Profile picture of Andrew Carnegie\">\n          </div>\n          <div>\n            <p class=\"author-name\">Andrew Carnegie</p>\n            <p class=\"author-location\">Pittsburgh, Pennsylvania</p>\n          </div>\n        </div>\n        <p class=\"testimonial-text\">\n          Excepturi nam cupiditate culpa doloremque deleniti repellat. Veniam quos repellat voluptas animi adipisci. Nisi eaque consequatur. Voluptatem dignissimos ut ducimus accusantium perspiciatis. Quasi voluptas eius distinctio. Atque eos maxime.\n        </p>\n      </article>\n      <article class=\"testimonial\" tabindex=\"0\">\n        <div class=\"author-info\">\n          <div class=\"author-image\">\n            <img src=\"https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/531c955c-4fa0-45f3-8287-c357cb5c37cf.png\" alt=\"Profile picture of John Morgan\">\n          </div>\n          <div>\n            <p class=\"author-name\">John Morgan</p>\n            <p class=\"author-location\">New York City</p>\n          </div>\n        </div>\n        <p class=\"testimonial-text\">\n          Repellat dignissimos libero. Qui sed at corrupti expedita voluptas odit. Nihil ea quia nesciunt. Ducimus aut sed ipsam. Autem eaque officia cum exercitationem sunt voluptatum accusamus. Quasi voluptas eius distinctio. Voluptatem dignissimos ut.\n        </p>\n      </article>\n      <article class=\"testimonial\" tabindex=\"0\">\n        <div class=\"author-info\">\n          <div class=\"author-image\">\n            <img src=\"https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/01927970-4c8d-488d-99e3-2876f724b8e8.png\" alt=\"Profile picture of Henry Ford\">\n          </div>\n          <div>\n            <p class=\"author-name\">Henry Ford</p>\n            <p class=\"author-location\">Dearborn, Michigan</p>\n          </div>\n        </div>\n        <p class=\"testimonial-text\">\n          Nunc interdum lacus sit amet orci. Vestibulum dapibus nunc ac augue. Fusce vel dui. In ac felis quis tortor malesuada pretium. Curabitur vestibulum aliquam leo. Qui sed at corrupti expedita voluptas odit. Nihil ea quia nesciunt. Ducimus aut sed ipsam.\n        </p>\n      </article>\n    </section>\n  \n  <script>\n    // Mobile menu toggle\n    const hamburgerBtn = document.querySelector('.hamburger');\n    const navPanel = document.querySelector('.nav-panel');\n    const navCloseBtn = document.querySelector('.nav-close');\n\n    hamburgerBtn.addEventListener('click', () => {\n      const expanded = hamburgerBtn.getAttribute('aria-expanded') === 'true' || false;\n      hamburgerBtn.setAttribute('aria-expanded', !expanded);\n      navPanel.classList.toggle('show');\n    });\n    navCloseBtn.addEventListener('click', () => {\n      hamburgerBtn.setAttribute('aria-expanded', false);\n      navPanel.classList.remove('show');\n    });\n\n    // Close menu when clicking outside nav-panel\n    window.addEventListener('click', (e) => {\n      if (!navPanel.contains(e.target) && !hamburgerBtn.contains(e.target)) {\n        hamburgerBtn.setAttribute('aria-expanded', false);\n        navPanel.classList.remove('show');\n      }\n    });\n\n    // Accessibility: Trap focus inside nav-panel when open\n    navPanel.addEventListener('keydown', (e) => {\n      if (!navPanel.classList.contains('show')) return;\n\n      const focusableElementsString = 'a[href], button:not([disabled])';\n      const focusableElements = Array.from(navPanel.querySelectorAll(focusableElementsString));\n      if (focusableElements.length === 0) return;\n\n      let index = focusableElements.indexOf(document.activeElement);\n\n      if (e.key === 'Tab') {\n        if (e.shiftKey) {\n          if (index === 0) {\n            focusableElements[focusableElements.length - 1].focus();\n            e.preventDefault();\n          }\n        } else {\n          if (index === focusableElements.length - 1) {\n            focusableElements[0].focus();\n            e.preventDefault();\n          }\n        }\n      }\n      if (e.key === 'Escape') {\n        hamburgerBtn.setAttribute('aria-expanded', false);\n        navPanel.classList.remove('show');\n        hamburgerBtn.focus();\n      }\n    });\n  </script>\n\n</main1>\n</body>",
